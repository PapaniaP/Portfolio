---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Import profile image - replace with actual image when available
import profileImage from '../assets/profile/profile.webp';

// Import images we need for featured projects
import rechargeImage from '../assets/projects/raskrask/recharge/recharge-cover.webp';
import harmonyImage from '../assets/projects/raskrask/harmony/harmonyUI-cover.webp';
import swishImage from '../assets/projects/swish/swish-cover.webp';
import maxiZooImage from '../assets/projects/maxizoo/mz-mockup.png';

// Background pattern
import bgPattern from '../assets/background.svg';

// Define featured projects
const featuredProjects = [
	{
		title: 'RaskRask Recharge',
		image: rechargeImage,
		description: 'My thesis project focused on enhancing user experience and business operations for RaskRask, a leading wellness service provider.',
		tags: ['UX Research', 'UI Design', 'Figma'],
		link: '/projects/raskrask-recharge',
		linkText: 'View Case Study'
	},
	{
		title: 'RaskRask Harmony UI',
		image: harmonyImage,
		description: 'A comprehensive design system created during my internship. Provides a consistent visual language for RaskRask\'s digital products.',
		tags: ['Design System', 'UI Components', 'Figma'],
		link: '/projects/harmony-ui',
		linkText: 'View Gallery'
	},
	{
		title: 'Swish Basketball App',
		image: swishImage,
		description: 'A pick-up basketball app that helps players find local games and connect with other enthusiasts. Focuses on intuitive UX/UI design.',
		tags: ['React', 'Firebase', 'UX/UI Design'],
		link: '/projects/swish',
		linkText: 'View Case Study'
	},
	{
		title: 'Maxi Zoo Rewards',
		image: maxiZooImage,
		description: 'A comprehensive UX case study focused on creating a digital concept for Maxi Zoo\'s loyalty program.',
		tags: ['UX Research', 'UI Design', 'Figma'],
		link: '/projects/maxizoo',
		linkText: 'View Case Study'
	}
];

// Social media links
const socialLinks = [
	{
		name: 'LinkedIn',
		url: 'https://linkedin.com/in/paolo-papania',
		icon: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>'
	},
	{
		name: 'GitHub',
		url: 'https://github.com/PapaniaP',
		icon: '<path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.73.083-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/>'
	},
	{
		name: 'Email',
		url: 'mailto:papaniap11@gmail.com',
		icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>'
	}
];

const skillAreas = [
	{
		title: "Frontend Development",
		description: "Building modern, responsive web applications with clean code and attention to detail",
		skills: ["React", "JavaScript", "TypeScript", "HTML/CSS", "Astro"],
		icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />`
	},
	{
		title: "UX/UI Design",
		description: "Creating intuitive, user-centered designs that balance aesthetics and functionality",
		skills: ["Figma", "User Research", "Wireframing", "Prototyping", "Design Systems"],
		icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />`
	},
	{
		title: "Digital Concept Development",
		description: "Turning complex problems into elegant solutions through creative thinking and technical knowledge",
		skills: ["Concept Ideation", "Design Thinking", "Technical Feasibility", "Product Strategy"],
		icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`
	}
];
---

<Layout title="Home">
	<!-- Hero Section -->
	<section class="py-20 md:py-32 relative overflow-hidden">
		<!-- Decorative elements - similar to Twingate's subtle background -->
		<div class="absolute inset-0 z-0 overflow-hidden">
			<!-- Similar to the Zero Trust Network diagram in Twingate -->
			<div class="absolute -top-1/4 -right-1/4 w-1/2 h-1/2 bg-gradient-to-br from-primary/10 to-blue-400/5 rounded-full blur-[120px] opacity-70"></div>
			<div class="absolute -bottom-1/4 -left-1/4 w-1/2 h-1/2 bg-gradient-to-tr from-primary/5 to-indigo-400/10 rounded-full blur-[100px] opacity-70"></div>

			<!-- Subtle dot pattern like in Twingate -->
			<div class="absolute inset-0 opacity-5">
				<div class="h-full w-full bg-[radial-gradient(#2563eb_1px,transparent_1px)] [background-size:20px_20px]"></div>
			</div>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="flex flex-col items-center text-center mb-16">
				<div class="inline-block mb-4 px-3 py-1 bg-primary/10 rounded-full">
					<span class="text-sm text-primary">Digital Concept Developer</span>
				</div>
				<h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 text-white">
					<span class="block">Remote access for the modern</span>
					<span class="block bg-clip-text text-transparent bg-gradient-to-r from-primary to-blue-400">Zero Trust network</span>
				</h1>
				<p class="text-xl text-gray-300 max-w-3xl mb-10">
					Crafting beautiful, user-centered digital experiences with a focus on clean code and modern design principles.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/projects" class="px-6 py-3 bg-primary hover:bg-primary-dark text-white rounded-lg font-medium transition-colors duration-300 flex items-center justify-center">
						View My Work
						<svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</a>
					<a href="/about" class="px-6 py-3 bg-gray-800 hover:bg-gray-700 text-white rounded-lg font-medium transition-colors duration-300 border border-gray-700">
						About Me
					</a>
				</div>
			</div>

			<!-- Profile image in a security-themed presentation -->
			<div class="max-w-5xl mx-auto relative">
				<div class="absolute inset-0 z-0">
					<div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl blur-md"></div>
				</div>

				<div class="relative z-10 rounded-xl overflow-hidden border border-gray-800 shadow-2xl">
					<Image
						src={profileImage}
						alt="Paolo Papania"
						width={1200}
						height={600}
						class="w-full h-auto object-cover"
					/>

					<!-- Decorative elements on the image -->
					<div class="absolute bottom-4 left-4 flex items-center gap-2 bg-gray-900/80 backdrop-blur-sm px-3 py-2 rounded-lg border border-gray-700">
						<div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
						<span class="text-sm text-white font-medium">Paolo's Portfolio</span>
					</div>

					<!-- Security indicators, inspired by Twingate's interface -->
					<div class="absolute top-4 right-4 flex items-center gap-3">
						<div class="w-10 h-10 rounded-full bg-gray-900/80 backdrop-blur-sm flex items-center justify-center border border-gray-700">
							<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
							</svg>
						</div>
						<div class="w-10 h-10 rounded-full bg-gray-900/80 backdrop-blur-sm flex items-center justify-center border border-gray-700">
							<svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
							</svg>
						</div>
						<div class="w-10 h-10 rounded-full bg-gray-900/80 backdrop-blur-sm flex items-center justify-center border border-gray-700">
							<svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
							</svg>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Core Skills Section (Redesigned for Twingate-inspired look) -->
	<section class="py-20 relative overflow-hidden">
		<div class="absolute inset-0 z-0">
			<div class="absolute top-1/4 right-1/4 w-96 h-96 bg-primary/5 rounded-full blur-[80px]"></div>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="text-center mb-16">
				<div class="text-xs font-medium text-primary uppercase tracking-wider mb-3">Core Competencies</div>
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-5">Build a best-in-class<br />skill ecosystem</h2>
				<p class="text-gray-400 max-w-2xl mx-auto">
					Leveraging a diverse skill set to create elegant, user-centered solutions for modern digital challenges
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
				{skillAreas.map((area, index) => (
					<div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 hover:-translate-y-1 group">
						<div class="p-6">
							<div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-5 group-hover:bg-primary/20 transition-colors duration-300">
								<svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<Fragment set:html={area.icon} />
								</svg>
							</div>
							<h3 class="text-xl font-semibold text-white mb-3">{area.title}</h3>
							<p class="text-gray-400 mb-5">{area.description}</p>
							<div class="flex flex-wrap gap-2">
								{area.skills.slice(0, 3).map(skill => (
									<span class="inline-flex px-3 py-1 text-xs text-primary bg-primary/10 rounded-full">{skill}</span>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Featured Projects -->
	<section class="py-20 relative overflow-hidden">
		<div class="absolute inset-0 z-0">
			<div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-blue-500/5 rounded-full blur-[80px]"></div>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="text-center mb-16">
				<div class="text-xs font-medium text-primary uppercase tracking-wider mb-3">Portfolio</div>
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-5">We've helped build<br />innovative solutions</h2>
				<p class="text-gray-400 max-w-2xl mx-auto">
					Explore featured projects that showcase my ability to solve complex problems through design and development
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				{featuredProjects.map((project, index) => (
					<div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 hover:-translate-y-1 group">
						<div class="relative h-48 overflow-hidden">
							<Image
								src={project.image}
								alt={project.title}
								width={600}
								height={300}
								class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent opacity-70"></div>
							<div class="absolute bottom-3 left-3 flex flex-wrap gap-2">
								{project.tags.map(tag => (
									<span class="px-2 py-1 text-xs bg-gray-900/80 backdrop-blur-sm text-white rounded-full border border-gray-700/50">
										{tag}
									</span>
								))}
							</div>
						</div>
						<div class="p-6">
							<h3 class="text-xl font-semibold text-white mb-3">{project.title}</h3>
							<p class="text-gray-400 mb-4">{project.description}</p>
							<a href={project.link} class="inline-flex items-center text-primary hover:text-blue-400 transition-colors">
								{project.linkText}
								<svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
								</svg>
							</a>
						</div>
					</div>
				))}
			</div>

			<div class="text-center mt-12">
				<a href="/projects" class="inline-flex items-center px-5 py-2 bg-gray-800 hover:bg-gray-700 text-white rounded-lg font-medium transition-colors duration-300 border border-gray-700">
					View All Projects
					<svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
					</svg>
				</a>
			</div>
		</div>
	</section>

	<!-- Connect Section (Twingate-inspired) -->
	<section class="py-20 relative overflow-hidden">
		<div class="absolute inset-0 z-0">
			<div class="absolute top-1/3 right-1/3 w-96 h-96 bg-indigo-500/5 rounded-full blur-[80px]"></div>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="text-center mb-16">
				<div class="text-xs font-medium text-primary uppercase tracking-wider mb-3">Connect</div>
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-5">Remote access for<br />collaboration</h2>
				<p class="text-gray-400 max-w-2xl mx-auto">
					Let's work together to bring your ideas to life with innovative solutions that meet your business goals
				</p>
			</div>

			<div class="max-w-5xl mx-auto bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-8 md:p-12">
				<div class="flex flex-col md:flex-row gap-10 items-center">
					<div class="flex-1">
						<h3 class="text-2xl font-bold text-white mb-5">Ready to collaborate?</h3>
						<p class="text-gray-400 mb-8">I'm always open to discussing new projects, creative ideas, or opportunities to be part of your vision.</p>

						<div class="flex flex-wrap gap-4">
							{socialLinks.map(link => (
								<a
									href={link.url}
									target={link.name !== 'Email' ? '_blank' : undefined}
									rel={link.name !== 'Email' ? 'noopener noreferrer' : undefined}
									class="flex items-center gap-2 px-4 py-2 bg-gray-700 hover:bg-gray-600 rounded-lg transition-colors duration-300 text-white"
								>
									<svg class="w-5 h-5" viewBox="0 0 24 24" fill={link.name === 'Email' ? 'none' : 'currentColor'} stroke={link.name === 'Email' ? 'currentColor' : 'none'}>
										<Fragment set:html={link.icon} />
									</svg>
									<span>{link.name}</span>
								</a>
							))}
						</div>
					</div>

					<div class="w-px h-40 bg-gray-700 hidden md:block"></div>

					<div class="flex-1">
						<div class="flex flex-col gap-5">
							<div class="flex items-start gap-4">
								<div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0">
									<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
									</svg>
								</div>
								<div>
									<h4 class="text-white font-medium mb-1">Location</h4>
									<p class="text-gray-400">Copenhagen, Denmark</p>
									<p class="text-gray-500 text-sm">Available for remote work worldwide</p>
								</div>
							</div>

							<div class="flex items-start gap-4">
								<div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0">
									<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
									</svg>
								</div>
								<div>
									<h4 class="text-white font-medium mb-1">Email</h4>
									<p class="text-gray-400">papaniap11@gmail.com</p>
									<p class="text-gray-500 text-sm">Available for freelance work</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
/* Gradient animations */
@keyframes gradientFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.gradient-text {
  background-size: 200% 200%;
  animation: gradientFlow 5s ease infinite;
}

/* Simple fade-in animation for content */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

section {
  animation: fadeIn 0.8s ease-out;
}

section:nth-child(2) {
  animation-delay: 0.2s;
}

section:nth-child(3) {
  animation-delay: 0.4s;
}

section:nth-child(4) {
  animation-delay: 0.6s;
}
</style>
