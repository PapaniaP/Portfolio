---
import Layout from '../layouts/Layout.astro';
import ButtonShowcase from '../components/ui/ButtonShowcase.astro';
---

<Layout title="Button Design Test">
  <div class="container mx-auto px-4 py-20">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-white mb-8">Button Design Test</h1>
      <p class="text-gray-300 mb-8">
        This page showcases the new shadcn-inspired button designs with the site's color scheme.
      </p>

      <ButtonShowcase />

      <div class="p-8 bg-gray-900 border border-gray-800 rounded-xl">
        <h2 class="text-2xl font-semibold text-white mb-6">Button Implementation</h2>
        <p class="text-gray-300 mb-4">
          The standardized button component supports multiple variants and sizes:
        </p>

        <pre class="bg-gray-800 p-4 rounded-md overflow-auto text-sm text-gray-300 mb-6"><code>&lt;Button variant="primary" size="md"&gt;
  Click Me
&lt;/Button&gt;

&lt;Button
  variant="outline"
  href="/some-link"
  size="lg"
&gt;
  Go to Link
&lt;/Button&gt;</code></pre>

        <div class="space-y-2 text-gray-300">
          <p><strong>Variants:</strong> primary, secondary, outline, ghost</p>
          <p><strong>Sizes:</strong> sm, md, lg, icon</p>
          <p><strong>Props:</strong> href (optional), class (optional), + all HTML attributes</p>
        </div>
      </div>
    </div>
  </div>
</Layout>