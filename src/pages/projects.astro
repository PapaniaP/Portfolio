---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import maxiZooImage from '../assets/projects/maxizoo/mz-mockup.png';
import levitoImage from '../assets/projects/levito/levito-home.webp';
import weatherAppImage from '../assets/projects/weather/weather-app-1.webp';
import hlousekImage from '../assets/projects/h&b/sk_home.png';
import cultureCaveImage from '../assets/projects/culture_cave/cc-22.png';
import portfolioImage from '../assets/projects/portfolio-23/portfolio-23.webp';
import swishImage from '../assets/projects/swish/swish-cover.webp';
import harmonyImage from '../assets/projects/raskrask/harmony/harmonyUI-cover.webp';
import rechargeImage from '../assets/projects/raskrask/recharge/recharge-cover.webp';
// Add Grundfos Ecademy image import
// import grundfosImage from '../assets/projects/grundfos/grundfos-cover.webp';
import Button from '../components/ui/Button.astro';
import Tag from '../components/ui/Tag.astro';

// Define types in the frontmatter section
interface ProjectLink {
	text: string;
	url: string;
	primary: boolean;
	disabled?: boolean;
}

interface Project {
	title: string;
	image: any; // Using 'any' to accept both string and imported images
	description: string;
	tags: string[];
	links: ProjectLink[];
	date: string; // Date of project completion (YYYY-MM format)
	featured: boolean; // Whether this is a featured project
	isUXUI?: boolean;
	isFrontend?: boolean;
	hasCaseStudy?: boolean;
}

// Note: Replace these placeholder URLs with imported images when you add them
// Example: import maxiZooImage from '../assets/projects/maxizoo/maxizoo.png';
// Then update the image property to use the imported image variable

const projects: Project[] = [
	{
		title: 'RaskRask Recharge',
		image: rechargeImage,
		description: 'My thesis project for my Multimedia Design degree. A comprehensive solution focused on enhancing the user experience and business operations for RaskRask, a leading wellness service provider.',
		tags: ['UX Research', 'UI Design', 'Figma', 'Prototyping', 'Thesis Project'],
		links: [
			{
				text: 'Case Study',
				url: '/projects/raskrask-recharge',
				primary: true
			},
			{
				text: 'Prototype',
				url: '#',
				primary: false
			}
		],
		date: '2024-01',
		featured: true
	},
	{
		title: 'Portfolio Website',
		image: portfolioImage,
		description: 'My personal portfolio website built with modern web technologies. Features a clean, accessible design with responsive layouts. The site showcases my projects and skills as a frontend developer and UX/UI designer.',
		tags: ['Astro', 'TailwindCSS', 'TypeScript', 'Responsive Design'],
		links: [
			{
				text: 'GitHub',
				url: 'https://github.com/PapaniaP/Portfolio',
				primary: true
			}
		],
		date: '2023-03',
		featured: false
	},
	{
		title: 'RaskRask Harmony UI',
		image: harmonyImage,
		description: 'A comprehensive design system created during my internship for my Multimedia Design degree. Harmony UI provides a consistent visual language and component library for RaskRask\'s digital products, ensuring cohesive user experiences across all platforms.',
		tags: ['Design System', 'UI Design', 'Figma', 'Documentation', 'Internship'],
		links: [
			{
				text: 'Gallery',
				url: '/projects/harmony-ui',
				primary: true
			}
		],
		date: '2024-01',
		featured: true
	},
	{
		title: 'Swish Basketball App',
		image: swishImage,
		description: 'A pick-up basketball app developed as a school project. The application helps players find local games, connect with other basketball enthusiasts, and organize matches. The project focused on UX/UI design principles and implementation using React with Firebase.',
		tags: ['React', 'Firebase', 'UX Research', 'UI Design', 'Figma', 'School Project'],
		links: [
			{
				text: 'Case Study (Coming Soon)',
				url: '#',
				primary: true,
				disabled: true
			},
			{
				text: 'Prototype',
				url: '#',
				primary: false
			}
		],
		date: '2023-11',
		featured: true
	},
	{
		title: 'Maxi Zoo Rewards',
		image: maxiZooImage,
		description: 'A comprehensive UX case study focused on creating a digital concept for Maxi Zoo\'s loyalty program. The project involved extensive user research, competitive analysis, and iterative design to develop an engaging and user-friendly rewards system that enhances customer loyalty and satisfaction.',
		tags: ['UX Research', 'UI Design', 'Figma', 'Prototyping'],
		links: [
			{
				text: 'Case Study (Coming Soon)',
				url: '#',
				primary: true,
				disabled: true
			},
			{
				text: 'Prototype',
				url: '#',
				primary: false
			}
		],
		date: '2025-05',
		featured: true
	},
	{
		title: 'Hlousek & Brokers',
		image: hlousekImage,
		description: 'WIP - Designed and developed an online platform for a small financial advisory business, providing them with a professional website and an established digital presence. This comprehensive project spanned from initial research to the final implementation, ensuring a seamless transition to the online world.',
		tags: ['WordPress', 'HTML', 'CSS', 'JavaScript', 'UX Research', 'UI Design'],
		links: [
			{
				text: 'Case Study (Coming Soon)',
				url: '#',
				primary: true,
				disabled: true
			},
			{
				text: 'Project',
				url: 'https://www.hlousekbrokers.sk/',
				primary: false
			}
		],
		date: '2022-03',
		featured: false
	},
	{
		title: 'Levito Pharmacies',
		image: levitoImage,
		description: 'Developed a comprehensive website for a chain of pharmacies in Slovakia, focusing on user-friendly navigation and clear presentation of services. The project involved creating a modern, accessible platform that serves both customers and healthcare professionals.',
		tags: ['WordPress', 'HTML', 'CSS', 'JavaScript', 'UI Design'],
		links: [
			{
				text: 'View Project',
				url: 'https://levito.dk/',
				primary: true
			}
		],
		date: '2024-10',
		featured: false
	},
	{
		title: 'Weather App',
		image: weatherAppImage,
		description: 'A weather app project created to learn JavaScript and API implementation. With this app, users can check the current weather conditions for a location by entering the city name.',
		tags: ['HTML', 'CSS', 'JavaScript', 'API Integration'],
		links: [
			{
				text: 'Project',
				url: 'https://papaniap.github.io/weather_app/',
				primary: true
			},
			{
				text: 'Code',
				url: 'https://github.com/PapaniaP/weather_app',
				primary: false
			}
		],
		date: '2022-07',
		featured: false
	},
	{
		title: 'Culture Cave',
		image: cultureCaveImage,
		description: 'Designed and developed a solo project dedicated to uncovering Verona\'s hidden gems, from food spots to wine shops and charming bars.',
		tags: ['HTML', 'CSS', 'JavaScript'],
		links: [
			{
				text: 'Project',
				url: 'https://papaniap.github.io/CultureCave/',
				primary: true
			},
			{
				text: 'Code',
				url: 'https://github.com/PapaniaP/CultureCave/',
				primary: false
			}
		],
		date: '2022-04',
		featured: false
	},
	// Add Grundfos Ecademy project
	{
		title: 'Grundfos Ecademy',
		// image: grundfosImage, // Uncomment when image is added
		image: 'https://via.placeholder.com/800x600.png?text=Grundfos+Ecademy', // Placeholder until image is added
		description: 'UX/UI design work for Grundfos Ecademy, a learning platform for professionals in the water industry.',
		tags: ['UX Research', 'UI Design', 'Business Analysis','User Testing', 'Figma', 'Prototyping'],
		links: [
			{
				text: 'Gallery',
				url: '/projects/grundfos-ecademy',
				primary: true
			}
		],
		date: '2025-09',
		featured: false
	}
];

// Get all unique tags from projects
const allTags = [...new Set(projects.flatMap(project => project.tags))].sort();

// Define categories for filtering
const categories = [
	{ name: 'All', filter: 'all' },
	{ name: 'UX/UI Design', filter: 'ux-ui' },
	{ name: 'Frontend', filter: 'frontend' },
	{ name: 'Case Study', filter: 'case-study' }
];

// Map projects to categories based on user specifications
projects.forEach(project => {
	// Reset properties
	project.isUXUI = false;
	project.isFrontend = false;
	project.hasCaseStudy = false;

	// Manually set based on project title to match user specifications
	if (project.title === 'RaskRask Recharge') {
		project.isUXUI = true;
		project.isFrontend = true;
		project.hasCaseStudy = true;
	}
	else if (project.title === 'RaskRask Harmony UI' || project.title === 'Grundfos Ecademy') {
		project.isUXUI = true;
	}
	else if (project.title === 'Portfolio Website' || project.title === 'Weather App' || project.title === 'Culture Cave') {
		project.isFrontend = true;
	}
	else if (project.title === 'Swish Basketball App') {
		project.isUXUI = true;
		project.isFrontend = true;
		project.hasCaseStudy = true;
	}
	else if (project.title === 'Maxi Zoo Rewards') {
		project.isUXUI = true;
		project.hasCaseStudy = true;
	}
	else if (project.title === 'Hlousek & Brokers') {
		project.isUXUI = true;
		project.isFrontend = true;
		project.hasCaseStudy = true;
	}
	else if (project.title === 'Levito Pharmacies') {
		project.isUXUI = true;
		project.isFrontend = true;
	}
});

// Get featured projects
const featuredProjects = projects.filter(project => project.featured);

// Sort projects - case studies first, then by date
const sortedProjects = [...projects].sort((a, b) => {
	// Case studies always come first
	if (a.hasCaseStudy && !b.hasCaseStudy) return -1;
	if (!a.hasCaseStudy && b.hasCaseStudy) return 1;

	// Then sort by date (newest first)
	const dateA = new Date(a.date);
	const dateB = new Date(b.date);
	return dateB.getTime() - dateA.getTime();
});

---

<Layout title="Projects" description="Explore Paolo Papania's portfolio of UX/UI design and frontend development projects.">
	<div class="container mx-auto px-4 py-20">
		<div class="max-w-4xl">
			<h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-6 animate-fadeIn">
				Projects
			</h1>
			<p class="text-lg text-text-secondary mb-8 max-w-2xl animate-fadeIn animation-delay-100">
				A collection of my work in frontend development and UX/UI design. Each project represents a unique challenge and showcases different aspects of my skills and approach to problem-solving.
			</p>
		</div>

		<div class="mb-12 animate-fadeIn animation-delay-200">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
				<div class="flex flex-wrap gap-2">
					{categories.map(category => (
						<Button
							variant={category.filter === 'all' ? 'primary' : 'secondary'}
							size="sm"
							data-filter={category.filter}
							type="button"
							class={`filter-btn ${category.filter === 'all' ? 'active' : ''}`}
							icon={category.filter === 'all' ? 'layout-grid' : category.filter === 'ux-ui' ? 'palette' : category.filter === 'frontend' ? 'code' : 'file-text'}
						>
							{category.name}
						</Button>
					))}
				</div>
				<div class="relative w-full md:w-auto">
					<input
						type="text"
						id="search-projects"
						placeholder="Search projects..."
						class="pl-10 pr-4 py-2 w-full md:w-64 border border-border-secondary rounded-lg bg-surface text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-primary transition-all"
					/>
					<svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
					</svg>
				</div>
			</div>
		</div>

		<div class="projects-container space-y-10 mt-12">
			{sortedProjects.map((project, index) => (
				<article class={`project-card relative bg-surface rounded-xl overflow-hidden backdrop-blur-sm border border-border-secondary transition-all duration-300 hover:shadow-glow-lg animate-fadeIn`}
                    style={`animation-delay: ${100 + (index * 100)}ms`}
					data-tags={JSON.stringify(project.tags)}
					data-title={project.title}
					data-featured={project.featured.toString()}
					data-uxui={(project.isUXUI || false).toString()}
					data-frontend={(project.isFrontend || false).toString()}
					data-casestudy={(project.hasCaseStudy || false).toString()}>
					<div class="grid md:grid-cols-[40%_60%] gap-0">
						<!-- Image Section - Full width on mobile, left side on desktop (40% width) -->
						<div class="order-1 bg-surface relative group h-52 sm:h-60 md:h-auto">
							<div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>
							<div class="h-full w-full overflow-hidden">
								<Image
									src={project.image}
									alt={`${project.title} Screenshot`}
									width={800}
									height={600}
									class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
								/>
							</div>
						</div>

						<!-- Content Section - Stacked below image on mobile, right side on desktop (60% width) -->
						<div class="order-2 p-4 sm:p-5 md:p-6 flex flex-col h-full">
							<div class="space-y-2.5 sm:space-y-3 md:space-y-4">
								<!-- Date as plain text -->
								<div class="text-xs text-text-secondary">
									{new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
								</div>

								<!-- Title with Archiv Grotesk font -->
								<h2 class="text-lg sm:text-xl md:text-2xl font-medium font-display text-text-primary">
									{project.title}
								</h2>

								<!-- Description - condensed on mobile -->
								<p class="text-text-secondary text-xs sm:text-sm md:text-base leading-relaxed line-clamp-3 sm:line-clamp-4 md:line-clamp-none">
									{project.description}
								</p>

								<!-- Tags with expandable functionality using Tag component -->
								<div class="tags-container" data-project-id={`project-${index}`}>
									<div class="tags-visible flex flex-wrap gap-2 items-center">
										{project.tags.slice(0, 2).map((tag) => (
											<Tag text={tag} variant="default" size="sm" />
										))}
										{project.tags.length > 2 && (
											<Button
												variant="ghost"
												size="sm"
												class="expand-tags px-2 py-0.5 text-xs font-medium text-text-secondary hover:text-brand-primary transition-colors cursor-pointer"
												aria-label="Show all tags"
											>
												+{project.tags.length - 2} more
											</Button>
										)}
									</div>

									{project.tags.length > 2 && (
										<div class="tags-expanded hidden animate-fadeIn">
											<div class="flex flex-wrap gap-2 items-center">
												{project.tags.map((tag) => (
													<Tag text={tag} variant="default" size="sm" />
												))}
												<Button
													variant="ghost"
													size="sm"
													class="collapse-tags px-2 py-0.5 text-xs font-medium text-brand-primary hover:text-brand-primary-dark transition-colors cursor-pointer"
													aria-label="Show fewer tags"
												>
													Show less
												</Button>
											</div>
										</div>
									)}
								</div>
							</div>

							<!-- Bottom section with buttons - right aligned on mobile for thumb access -->
							<div class="mt-auto pt-3 sm:pt-4 md:pt-5">
								<div class="flex flex-wrap gap-2 justify-end md:justify-start">
									{project.links.map((link) => (
										<Button
											href={link.url}
											variant={link.primary ? 'primary' : 'secondary'}
											size="sm"
											target={link.url.startsWith('http') ? '_blank' : undefined}
											rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
											disabled={link.disabled}
										>
											{link.text}
										</Button>
									))}
								</div>
							</div>
						</div>
					</div>
				</article>
			))}

			<div id="no-results" class="hidden py-16 text-center">
				<svg class="mx-auto h-12 w-12 text-brand-primary-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
				</svg>
				<h3 class="mt-2 text-lg font-medium text-text-primary">No projects found</h3>
				<p class="mt-1 text-text-secondary">Try changing your search or filter criteria.</p>
				<Button
					id="reset-filters-btn"
					variant="primary"
					size="md"
					icon="refresh-cw"
					class="mt-4"
				>
					Reset Filters
				</Button>
			</div>
		</div>
	</div>

	<!-- Replace the script define:vars with a direct script -->
	<script>
// Wait until page is fully loaded
document.addEventListener('DOMContentLoaded', () => {
  console.log('Projects page initialized');

  // Get elements
  const filterButtons = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');
  const searchInput = document.getElementById('search-projects') as HTMLInputElement;
  const noResultsDiv = document.getElementById('no-results');
  const resetButton = document.getElementById('reset-filters-btn');

  console.log('Elements found:', {
    buttons: filterButtons.length,
    cards: projectCards.length,
    searchInput: !!searchInput,
    noResults: !!noResultsDiv,
    resetBtn: !!resetButton
  });

  if (!filterButtons.length || !projectCards.length) {
    console.error('Required elements not found');
    return;
  }

  // Set up state
  let activeFilter = 'all';
  let searchTerm = '';

  // Helper classes
  const activeClasses = ['active', 'bg-brand-primary', 'text-text-inverted', 'shadow-sm'];
  const inactiveClasses = ['bg-surface', 'text-text-primary', 'hover:bg-surface-accent', 'border', 'border-border-secondary'];

  // Filter function
  function filterProjects() {
    console.log('Filtering projects:', { filter: activeFilter, search: searchTerm });
    let hasVisibleProjects = false;

    projectCards.forEach(card => {
      // Get card data
      const title = card.getAttribute('data-title')?.toLowerCase() || '';
      const isUxUi = card.getAttribute('data-uxui') === 'true';
      const isFrontend = card.getAttribute('data-frontend') === 'true';
      const hasCaseStudy = card.getAttribute('data-casestudy') === 'true';

      // Check category match
      let matchesCategory = false;
      switch(activeFilter) {
        case 'all':
          matchesCategory = true;
          break;
        case 'ux-ui':
          matchesCategory = isUxUi;
          break;
        case 'frontend':
          matchesCategory = isFrontend;
          break;
        case 'case-study':
          matchesCategory = hasCaseStudy;
          break;
      }

      // Check search match
      const matchesSearch = !searchTerm || title.includes(searchTerm);

      // Show/hide card
      if (matchesCategory && matchesSearch) {
        card.classList.remove('hidden');
        card.classList.add('animate-fadeIn');
        hasVisibleProjects = true;
      } else {
        card.classList.add('hidden');
        card.classList.remove('animate-fadeIn');
      }
    });

    // Toggle no results message
    if (noResultsDiv) {
      if (hasVisibleProjects) {
        noResultsDiv.classList.add('hidden');
      } else {
        noResultsDiv.classList.remove('hidden');
      }
    }
  }

  // Set up button click handlers
  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const newFilter = btn.getAttribute('data-filter');
      console.log('Button clicked:', newFilter);

      if (!newFilter || newFilter === activeFilter) return;

      // Update active filter
      activeFilter = newFilter;

      // Update button states
      filterButtons.forEach(b => {
        b.classList.remove(...activeClasses);
        b.classList.add(...inactiveClasses);
      });

      btn.classList.remove(...inactiveClasses);
      btn.classList.add(...activeClasses);

      // Apply filter
      filterProjects();
    });
  });

  // Set up search handler
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchTerm = searchInput.value.toLowerCase();
      filterProjects();
    });
  }

  // Set up reset button
  if (resetButton) {
    resetButton.addEventListener('click', () => {
      // Reset state
      activeFilter = 'all';
      searchTerm = '';

      if (searchInput) searchInput.value = '';

      // Reset button styles
      filterButtons.forEach(btn => {
        const isAllButton = btn.getAttribute('data-filter') === 'all';

        btn.classList.remove(...activeClasses);
        btn.classList.add(...inactiveClasses);

        if (isAllButton) {
          btn.classList.remove(...inactiveClasses);
          btn.classList.add(...activeClasses);
        }
      });

      // Apply filter
      filterProjects();
    });
  }

  // Run initial filter
  filterProjects();
});
	</script>

	<!-- Add this script at the end of the file to handle tag expansion -->
	<script>
	document.addEventListener('DOMContentLoaded', () => {
	  // Handle tags expansion behavior
	  const tagContainers = document.querySelectorAll('.tags-container');
	  const collapseTimeout = 12000; // 12 seconds
	  const timers: Record<string, number> = {};

	  tagContainers.forEach(container => {
		const projectId = container.getAttribute('data-project-id') || '';
		const expandButton = container.querySelector('.expand-tags');
		const collapseButton = container.querySelector('.collapse-tags');
		const visibleTags = container.querySelector('.tags-visible');
		const expandedTags = container.querySelector('.tags-expanded');

		if (!expandButton || !collapseButton || !visibleTags || !expandedTags) return;

		function expandTags() {
		  if (visibleTags && expandedTags) {
			visibleTags.classList.add('hidden');
			expandedTags.classList.remove('hidden');

			// Set timeout to collapse after 12 seconds
			clearTimeout(timers[projectId]);
			timers[projectId] = window.setTimeout(() => {
			  collapseTags();
			}, collapseTimeout);
		  }
		}

		function collapseTags() {
		  if (visibleTags && expandedTags) {
			expandedTags.classList.add('hidden');
			visibleTags.classList.remove('hidden');
			clearTimeout(timers[projectId]);
		  }
		}

		expandButton.addEventListener('click', expandTags);
		collapseButton.addEventListener('click', collapseTags);
	  });

	  // Clean up timers when navigating away
	  window.addEventListener('beforeunload', () => {
		Object.keys(timers).forEach(key => clearTimeout(timers[key]));
	  });
	});
	</script>
</Layout>