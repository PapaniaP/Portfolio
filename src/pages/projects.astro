			}
		],
		date: '2021-07',
		featured: false
	},
	{
		title: 'Culture Cave',
		image: cultureCaveImage,
		description: 'Designed and developed a solo project dedicated to uncovering Verona\'s hidden gems, from food spots to wine shops and charming bars.',
		tags: ['HTML', 'CSS', 'JavaScript'],
		links: [
			{
				text: 'Project',
				url: 'https://papaniap.github.io/CultureCave/',
				primary: false
			},
			{
				text: 'Code',
				url: 'https://github.com/PapaniaP/CultureCave/',
				primary: true
			}
		],
		date: '2021-04',
		featured: false
	}
];

// Get all unique tags from projects
const allTags = [...new Set(projects.flatMap(project => project.tags))].sort();

// Define simplified categories for filtering
const categories = [
	{ name: 'All', filter: 'all' },
	{ name: 'UX/UI Design', filter: 'ux-ui' },
	{ name: 'Frontend', filter: 'frontend' }
];

// Map projects to categories for filtering
projects.forEach(project => {
	// Add simplified category flags for filtering
	const hasUXUI = project.tags.some(tag =>
		['UX Research', 'UI Design', 'Figma', 'Prototyping', 'Design System', 'UX/UI Design'].includes(tag)
	);

	const hasFrontend = project.tags.some(tag =>
		['React', 'Firebase', 'HTML', 'CSS', 'JavaScript', 'WordPress', 'Astro', 'TailwindCSS', 'TypeScript', 'Responsive Design'].includes(tag)
	);

	// Add these as data attributes when rendering
	project.isUXUI = hasUXUI;
	project.isFrontend = hasFrontend;
});

// Get featured projects
const featuredProjects = projects.filter(project => project.featured);

// Client-side filtering script
const filterScript = `
document.addEventListener('DOMContentLoaded', () => {
  const filterButtons = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');
  const searchInput = document.getElementById('search-projects');

  let activeFilter = 'all';
  let searchTerm = '';

  function filterProjects() {
    projectCards.forEach(card => {
      const cardTitle = card.dataset.title.toLowerCase();
      const isUXUI = card.dataset.uxui === 'true';
      const isFrontend = card.dataset.frontend === 'true';

      let matchesCategory = false;
      if (activeFilter === 'all') {
        matchesCategory = true;
      } else if (activeFilter === 'ux-ui') {
        matchesCategory = isUXUI;
      } else if (activeFilter === 'frontend') {
        matchesCategory = isFrontend;
      }

      const matchesSearch = !searchTerm || cardTitle.includes(searchTerm);

      if (matchesCategory && matchesSearch) {
        card.classList.remove('hidden');
        // Add entrance animation
        card.classList.add('animate-fadeIn');
        setTimeout(() => {
          card.classList.remove('animate-fadeIn');
        }, 500);
      } else {
        card.classList.add('hidden');
      }
    });

    // Check if any projects are visible
    const hasVisibleProjects = Array.from(projectCards).some(card => !card.classList.contains('hidden'));

    if (!hasVisibleProjects) {
      document.getElementById('no-results').classList.remove('hidden');
    } else {
      document.getElementById('no-results').classList.add('hidden');
    }
  }

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      filterButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');
      activeFilter = button.dataset.filter;
      filterProjects();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchTerm = e.target.value.toLowerCase();
    filterProjects();
  });
});
`;
---

<Layout title="Projects">
	<div class="container mx-auto px-4 py-20">
		<div class="max-w-4xl">
			<h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 animate-fadeIn">
				Projects
			</h1>
			<p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-2xl animate-fadeIn animation-delay-100">
				A collection of my work in frontend development and UX/UI design. Each project represents a unique challenge and showcases different aspects of my skills and approach to problem-solving.
			</p>
		</div>

		<!-- Filter Controls -->
		<div class="mb-12 animate-fadeIn animation-delay-200">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
				<div class="flex flex-wrap gap-2">
					{categories.map(category => (
						<button class={`filter-btn px-4 py-2 text-sm font-medium rounded-lg transition-all duration-300
                            ${category.filter === 'all' ? 'active bg-gradient-to-r from-primary to-primary-light text-white shadow-glow-sm' : 'bg-gray-800/60 text-gray-200 hover:bg-gray-700 border border-gray-700'}`}
                            data-filter={category.filter}>
							{category.name}
						</button>
					))}
				</div>
				<div class="relative w-full md:w-auto">
					<input
						type="text"
						id="search-projects"
						placeholder="Search projects..."
						class="pl-10 pr-4 py-2 w-full md:w-64 border border-gray-700 rounded-lg bg-gray-800/60 text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary transition-all"
					/>
					<svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
					</svg>
				</div>
			</div>
		</div>

		<!-- All Projects Section -->
		<h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 animate-fadeIn animation-delay-300">All Projects</h2>
		<div class="projects-container space-y-10">
			{projects.map((project, index) => (
				<article class={`project-card relative bg-gray-800/60 rounded-xl shadow-glow-md overflow-hidden backdrop-blur-sm border border-gray-700 transition-all duration-300 hover:shadow-glow-lg animate-fadeIn`}
                    style={`animation-delay: ${300 + (index * 100)}ms`}
					data-tags={JSON.stringify(project.tags)}
					data-title={project.title}
					data-featured={project.featured.toString()}
					data-uxui={(project.isUXUI || false).toString()}
					data-frontend={(project.isFrontend || false).toString()}>
                    {/* Gradient accent */}
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary via-primary-light to-accent opacity-80"></div>
					<div class="grid md:grid-cols-2 gap-0">
						<div class="order-2 md:order-1 p-6 md:p-8 flex flex-col justify-between h-full">
							<div>
								<div class="flex justify-between items-start mb-3">
									<h2 class="text-2xl font-bold text-white group-hover:text-primary transition-colors">
										{project.title}
									</h2>
									<span class="text-sm text-primary-light px-3 py-1 rounded-full bg-gray-900/50 border border-gray-700">
										{new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
									</span>
								</div>
								<p class="text-gray-300 mb-6">
									{project.description}
								</p>
								<div class="flex flex-wrap gap-2 mb-6">
									{project.tags.map((tag) => (
										<span class="px-3 py-1 text-sm bg-gray-900/70 text-primary-light border border-gray-700 rounded-full backdrop-blur-sm">
											{tag}
										</span>
									))}
								</div>
							</div>
							<div class="flex flex-wrap gap-3 mt-4">
								{project.links.map((link) => (
									<a
										href={link.url}
										class={`inline-flex items-center px-5 py-2 text-base font-medium rounded-lg transition-all duration-300
											${link.primary
												? 'text-white bg-gradient-to-r from-primary to-primary-light hover:shadow-glow-sm'
												: 'text-gray-200 bg-gray-900/70 border border-gray-700 hover:bg-gray-700 hover:text-white'
											}`}
										target={link.url.startsWith('http') ? '_blank' : undefined}
										rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
									>
										{link.text}
										{link.url.startsWith('http') && (
											<svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
											</svg>
										)}
									</a>
								))}
							</div>
						</div>
						<div class="order-1 md:order-2 bg-gray-900 h-full relative group">
                            {/* Hover overlay with gradient */}
                            <div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>
							<div class="h-full w-full overflow-hidden">
								<Image
									src={project.image}
									alt={`${project.title} Screenshot`}
									width={800}
									height={600}
									class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
								/>
							</div>
						</div>
					</div>
				</article>
			))}

			<!-- No results message -->
			<div id="no-results" class="hidden py-16 text-center">
				<svg class="mx-auto h-12 w-12 text-primary-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
				</svg>
				<h3 class="mt-2 text-lg font-medium text-white">No projects found</h3>
				<p class="mt-1 text-gray-400">Try changing your search or filter criteria.</p>
				<button class="mt-4 px-4 py-2 bg-gradient-to-r from-primary to-primary-light text-white rounded-lg hover:shadow-glow-sm transition-all" onclick="resetFilters()">
					Reset Filters
				</button>
			</div>
		</div>
	</div>

	<script define:vars={{ filterScript }}>
		{filterScript}

		function resetFilters() {
			document.querySelectorAll('.filter-btn').forEach(btn => {
				if (btn.dataset.filter === 'all') {
					btn.classList.add('active', 'bg-gradient-to-r', 'from-primary', 'to-primary-light', 'text-white', 'shadow-glow-sm');
					btn.classList.remove('bg-gray-800/60', 'text-gray-200', 'border', 'border-gray-700');
				} else {
					btn.classList.remove('active', 'bg-gradient-to-r', 'from-primary', 'to-primary-light', 'text-white', 'shadow-glow-sm');
					btn.classList.add('bg-gray-800/60', 'text-gray-200', 'border', 'border-gray-700');
				}
			});

			document.getElementById('search-projects').value = '';

			// Manually trigger the filtering logic again
			const event = new Event('input');
			document.getElementById('search-projects').dispatchEvent(event);
		}
	</script>
</Layout>