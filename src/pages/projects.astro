		date: '2021-10',
		featured: false
	},
	{
		title: 'Weather App',
		image: weatherAppImage,
		description: 'A weather app project created to learn JavaScript and API implementation. With this app, users can check the current weather conditions for a location by entering the city name.',
		tags: ['HTML', 'CSS', 'JavaScript'],
		links: [
			{
				text: 'Project',
				url: 'https://papaniap.github.io/weather_app/',
				primary: false
			},
			{
				text: 'Code',
