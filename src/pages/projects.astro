				primary: false
			},
			{
				text: 'Code',
				url: 'https://github.com/PapaniaP/H-B',
				primary: true
			}
		],
		date: '2022-03',
		featured: false
	},
	{
		title: 'Levito Pharmacies',
		image: levitoImage,
		description: 'Developed a comprehensive website for a chain of pharmacies in Slovakia, focusing on user-friendly navigation and clear presentation of services. The project involved creating a modern, accessible platform that serves both customers and healthcare professionals.',
		tags: ['WordPress', 'HTML', 'CSS', 'JavaScript'],
		links: [
			{
				text: 'View Project',
				url: 'https://levito.dk/',
				primary: true
			}
