---
import { motion } from 'framer-motion';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import AnimatedSection from '../components/AnimatedSection';

// Import profile image - replace with actual image when available
import profileImage from '../assets/profile/profile.webp';

// Import images we need for featured projects
import rechargeImage from '../assets/projects/raskrask/recharge/recharge-cover.webp';
import harmonyImage from '../assets/projects/raskrask/harmony/harmonyUI-cover.webp';
import swishImage from '../assets/projects/swish/swish-cover.webp';
import maxiZooImage from '../assets/projects/maxizoo/mz-mockup.png';

// Background pattern
import bgPattern from '../assets/background.svg';

// Define featured projects
const featuredProjects = [
	{
		title: 'RaskRask Recharge',
		image: rechargeImage,
		description: 'My thesis project focused on enhancing user experience and business operations for RaskRask, a leading wellness service provider.',
		tags: ['UX Research', 'UI Design', 'Figma'],
		link: '/projects/raskrask-recharge',
		linkText: 'View Case Study'
	},
	{
		title: 'RaskRask Harmony UI',
		image: harmonyImage,
		description: 'A comprehensive design system created during my internship. Provides a consistent visual language for RaskRask\'s digital products.',
		tags: ['Design System', 'UI Components', 'Figma'],
		link: '/projects/harmony-ui',
		linkText: 'View Gallery'
	},
	{
		title: 'Swish Basketball App',
		image: swishImage,
		description: 'A pick-up basketball app that helps players find local games and connect with other enthusiasts. Focuses on intuitive UX/UI design.',
		tags: ['React', 'Firebase', 'UX/UI Design'],
		link: '/projects/swish',
		linkText: 'View Case Study'
	},
	{
		title: 'Maxi Zoo Rewards',
		image: maxiZooImage,
		description: 'A comprehensive UX case study focused on creating a digital concept for Maxi Zoo\'s loyalty program.',
		tags: ['UX Research', 'UI Design', 'Figma'],
		link: '/projects/maxizoo',
		linkText: 'View Case Study'
	}
];

// Social media links
const socialLinks = [
	{
		name: 'LinkedIn',
		url: 'https://linkedin.com/in/paolo-papania',
		icon: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>'
	},
	{
		name: 'GitHub',
		url: 'https://github.com/PapaniaP',
		icon: '<path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.73.083-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/>'
	},
	{
		name: 'Email',
		url: 'mailto:papaniap11@gmail.com',
		icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>'
	}
];

const skillAreas = [
	{
		title: "Frontend Development",
		description: "Building modern, responsive web applications with clean code and attention to detail",
		skills: ["React", "JavaScript", "TypeScript", "HTML/CSS", "Astro"],
		icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />`
	},
	{
		title: "UX/UI Design",
		description: "Creating intuitive, user-centered designs that balance aesthetics and functionality",
		skills: ["Figma", "User Research", "Wireframing", "Prototyping", "Design Systems"],
		icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />`
	},
	{
		title: "Digital Concept Development",
		description: "Turning complex problems into elegant solutions through creative thinking and technical knowledge",
		skills: ["Concept Ideation", "Design Thinking", "Technical Feasibility", "Product Strategy"],
		icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`
	}
];
---

<Layout title="Home">
	<!-- Global background grid for entire page -->
	<div class="fixed inset-0 z-[-1] opacity-10">
		<div class="h-full w-full bg-[linear-gradient(#374151_1px,transparent_1px),linear-gradient(to_right,#374151_1px,transparent_1px)] [background-size:80px_80px]"></div>
	</div>

	<!-- Hero Section -->
	<AnimatedSection client:load id="hero" className="py-24 md:py-32 relative overflow-hidden">
		<!-- Decorative elements -->
		<div class="absolute inset-0 z-0 overflow-hidden">
			<!-- Creative geometric elements -->
			<div class="absolute top-20 md:top-40 right-[10%] w-72 h-72 border border-primary/20 rounded-full opacity-20"></div>
			<div class="absolute top-40 md:top-60 right-[5%] w-36 h-36 border border-blue-400/20 rounded-full opacity-20"></div>
			<div class="absolute bottom-20 left-[10%] w-52 h-52 border border-indigo-400/20 rounded-full opacity-20"></div>

			<!-- Gradient blobs -->
			<div class="absolute -top-1/4 -right-1/4 w-1/2 h-1/2 bg-gradient-to-br from-primary/10 to-blue-400/5 rounded-full blur-[120px] opacity-70"></div>
			<div class="absolute -bottom-1/4 -left-1/4 w-1/2 h-1/2 bg-gradient-to-tr from-primary/5 to-indigo-400/10 rounded-full blur-[100px] opacity-70"></div>

			<!-- Decorative diagonal lines -->
			<div class="absolute top-0 right-0 w-1/2 h-1/2 overflow-hidden opacity-10 pointer-events-none">
				<div class="absolute -top-1/2 -right-1/2 w-full h-full border-t border-l border-primary/30 rotate-45 transform origin-bottom-left"></div>
				<div class="absolute -top-1/4 -right-1/4 w-full h-full border-t border-l border-primary/20 rotate-45 transform origin-bottom-left"></div>
			</div>
		</div>

		<div class="container mx-auto px-6 md:px-8 relative z-10">
			<div class="flex flex-col md:flex-row items-start gap-12 md:gap-8">
				<!-- Left Column - Text Content -->
				<div class="md:w-1/2 w-full pt-4 md:pt-12">
					<!-- Floating badge -->
					<div class="inline-flex items-center px-3 py-1.5 bg-primary/10 border border-primary/20 rounded-full mb-8 relative">
						<div class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-primary/40 animate-ping"></div>
						<span class="text-sm text-primary font-medium">Digital Concept Developer</span>
					</div>

					<h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-8 text-white leading-tight">
						<span class="block mb-2 relative">
							Design
							<span class="relative">
								Beyond
								<svg class="absolute -bottom-2 left-0 w-full h-2 text-primary/40" preserveAspectRatio="none" viewBox="0 0 100 10" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M0 5C20 2 50 2 100 8" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
								</svg>
							</span>
						</span>
						<span class="block bg-clip-text text-transparent bg-gradient-to-r from-primary to-blue-400">Expectations</span>
					</h1>

					<p class="text-xl text-gray-300 mb-10 max-w-xl relative">
						Crafting beautiful, user-centered digital experiences with a focus on clean code and modern design principles.
						<svg class="absolute -left-8 top-0 h-full w-1 opacity-30" preserveAspectRatio="none" viewBox="0 0 10 100" xmlns="http://www.w3.org/2000/svg">
							<line x1="5" y1="0" x2="5" y2="100" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4"></line>
						</svg>
					</p>

					<div class="flex flex-wrap gap-5 mb-16">
						<a
						href="/projects"
						aria-label="View my work"
						role="button"
						class="group px-7 py-3.5 bg-primary rounded-lg font-medium transition-all duration-300 flex items-center relative overflow-hidden"
					>							<span class="absolute inset-0 w-full h-full bg-gradient-to-r from-primary to-primary-dark transition-transform duration-300 group-hover:translate-x-0 -translate-x-full"></span>
							<span class="relative text-white flex items-center">
								View My Work
								<svg class="ml-2 w-5 h-5 transition-transform duration-300 group-hover:translate-x-1 group-hover:scale-110 motion-safe:animate-pulse" />
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
								</svg>
							</span>
						</a>

						<a
						href="/cv.pdf"
						aria-label="Download CV"
						role="button"
						class="group px-7 py-3.5 bg-gray-800 hover:bg-gray-700 text-white rounded-lg font-medium transition-all duration-300 border border-gray-700/50 hover:border-gray-700 relative"
						target="_blank"
						rel="noopener noreferrer"
					>							<span class="absolute inset-0 bg-gradient-to-r from-gray-800 to-gray-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
							<span class="relative">Download CV</span>
						</a>
					</div>

					<!-- Client logos strip -->
					<div class="relative pl-8 border-l border-gray-700/50">
						<div class="absolute -left-2.5 top-0 w-5 h-5 bg-gray-900 border border-gray-700/50 rounded-full flex items-center justify-center">
							<div class="w-1.5 h-1.5 bg-primary rounded-full"></div>
						</div>
						<p class="text-sm text-gray-500 uppercase tracking-wider font-medium mb-6">Clients & Collaborations</p>
						<div class="flex flex-wrap gap-x-8 gap-y-4">
							<span class="text-base font-medium text-gray-400 transition-colors hover:text-primary">RaskRask</span>
							<span class="text-base font-medium text-gray-400 transition-colors hover:text-primary">Maxi Zoo</span>
							<span class="text-base font-medium text-gray-400 transition-colors hover:text-primary">Swish App</span>
							<span class="text-base font-medium text-gray-400 transition-colors hover:text-primary">KEA</span>
						</div>
					</div>
				</div>

				<!-- Right Column - Creative Profile Display -->
				<div class="md:w-1/2 w-full md:mt-0 mt-12 relative max-h-[500px] md:max-h-none ">					<!-- Stacked cards effect -->
					<div class="relative mx-auto max-w-sm">
						<!-- Background card -->
						<div class="absolute -top-4 -right-4 w-full h-full bg-gray-800/30 backdrop-blur-sm border border-gray-700/50 rounded-lg transform rotate-6"></div>
						<div class="absolute -bottom-4 -left-4 w-full h-full bg-gray-800/30 backdrop-blur-sm border border-gray-700/50 rounded-lg transform -rotate-3"></div>

						<!-- Main card with terminal styling -->
						<div class="relative bg-gray-800/70 backdrop-blur-sm border border-gray-700/80 rounded-lg overflow-hidden shadow-2xl">
							<!-- Terminal header -->
							<div class="bg-gray-900 border-b border-gray-700/80 px-4 py-2 flex items-center">
								<div class="flex space-x-1.5">
									<div class="w-3 h-3 rounded-full bg-red-500/70"></div>
									<div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
									<div class="w-3 h-3 rounded-full bg-green-500/70"></div>
								</div>
								<div class="flex-1 text-center">
									<div class="inline-flex items-center px-2 py-1 mx-auto bg-gray-800/80 rounded text-xs text-gray-400">
										<span class="text-primary mr-1.5">~</span> paolo-papania.dev
									</div>
								</div>
								<div class="w-8"></div> <!-- Spacer for balance -->
							</div>

							<!-- Terminal content with image -->
							<div class="p-1">
								<div class="relative rounded overflow-hidden">
									<Image
										src={profileImage}
										alt="Paolo Papania"
										width={600}
										height={700}
										class="w-full h-auto object-cover"
									/>


									<!-- Overlay gradient -->
									<div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-transparent to-transparent"></div>
								</div>

								<!-- Terminal command line at bottom -->
								<div class="px-4 py-3 flex items-center text-sm font-mono">
									<span class="text-green-400 mr-1.5">➜</span>
									<span class="text-blue-400 mr-1.5">portfolio</span>
									<span class="text-primary mr-2">$</span>
									<span class="text-gray-300">npm run design</span>
									<span class="ml-2 h-4 w-1 bg-white animate-pulse"></span>
								</div>
							</div>

							<!-- Status bar -->
							<div class="absolute bottom-14 left-4 right-4 bg-gray-900/90 backdrop-blur-sm border border-gray-700/80 rounded px-3 py-2 text-xs flex justify-between items-center">
								<div class="flex items-center">
									<div class="w-2 h-2 bg-green-500 rounded-full animate-pulse mr-2"></div>
									<span class="text-gray-300">Looking for internship</span>
								</div>
								<div class="text-gray-500">Frontend • UX/UI Design </div>
							</div>
						</div>

						<!-- Decorative floating elements -->
						<div class="absolute -top-4 -left-4 w-12 h-12 bg-primary/10 border border-primary/30 rounded-lg transform rotate-12 flex items-center justify-center">
							<svg aria-hidden="true" class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
							</svg>
						</div>
						<div class="absolute -bottom-6 -right-2 w-10 h-10 bg-blue-500/10 border border-blue-500/30 rounded-full flex items-center justify-center">
							<svg aria-hidden="true" class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
							</svg>
						</div>
					</div>
				</div>
			</div>
		</div>
	</AnimatedSection>

	<!-- Core Skills Section (Twingate-inspired styling) -->
	<AnimatedSection client:load id="skills" className="py-20 relative overflow-hidden">
		<div class="absolute inset-0 z-0">
			<div class="absolute top-1/4 right-1/4 w-96 h-96 bg-primary/5 rounded-full blur-[80px]"></div>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="max-w-5xl mx-auto">
				<div class="text-left mb-16">
					<div class="text-xs font-medium text-primary uppercase tracking-wider mb-3">Core Competencies</div>
					<h2 class="text-3xl md:text-4xl font-bold text-white mb-5">Build a best-in-class<br />design ecosystem</h2>
					<p class="text-gray-400 max-w-2xl">
						Leveraging a diverse skill set to create elegant, user-centered solutions for modern digital challenges
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					{skillAreas.map((area, index) => (
						<div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 hover:-translate-y-1 group">
							<div class="p-6">
								<div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-5 group-hover:bg-primary/20 transition-colors duration-300">
									<svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<Fragment set:html={area.icon} />
									</svg>
								</div>
								<h3 class="text-xl font-semibold text-white mb-3">{area.title}</h3>
								<p class="text-gray-400 mb-5">{area.description}</p>
								<div class="flex flex-wrap gap-2">
									{area.skills.slice(0, 3).map(skill => (
										<span class="inline-flex px-3 py-1 text-xs text-primary bg-primary/10 rounded-full">{skill}</span>
									))}
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</AnimatedSection>

	<!-- Featured Projects (Twingate-inspired UI) -->
	<AnimatedSection client:load id="projects" className="py-20 relative overflow-hidden">
		<div class="absolute inset-0 z-0">
			<div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-blue-500/5 rounded-full blur-[80px]"></div>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="max-w-5xl mx-auto">
				<div class="text-left mb-16">
					<div class="text-xs font-medium text-primary uppercase tracking-wider mb-3">Portfolio</div>
					<h2 class="text-3xl md:text-4xl font-bold text-white mb-5">Innovative UX solutions<br />for complex challenges</h2>
					<p class="text-gray-400 max-w-2xl">
						Explore featured projects that showcase my ability to solve complex problems through design and development
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					{featuredProjects.map((project, index) => (
						<div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 hover:-translate-y-1 group">
							<div class="relative aspect-video">
								<Image
									src={project.image}
									alt={project.title}
									width={1200}
									height={675}
									class="w-full h-full object-cover"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent opacity-60"></div>
								<div class="absolute bottom-4 left-4 flex flex-wrap gap-2">
									{project.tags.map(tag => (
										<span class="px-2 py-1 text-xs bg-gray-900/80 backdrop-blur-sm text-white rounded-full border border-gray-700/50">
											{tag}
										</span>
									))}
								</div>
							</div>
							<div class="p-6">
								<h3 class="text-xl font-semibold text-white mb-3">{project.title}</h3>
								<p class="text-gray-400 mb-4">{project.description}</p>
								<a
									href={project.link}
									class="inline-flex items-center text-primary hover:text-blue-400 transition-colors"
									aria-label={`View ${project.title} project details`}
								>
									{project.linkText}
									<svg class="ml-2 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
									</svg>
								</a>
							</div>
						</div>
					))}
				</div>

				<div class="mt-12">
					<a href="/projects" class="inline-flex items-center px-5 py-2 bg-gray-800 hover:bg-gray-700 text-white rounded-lg font-medium transition-colors duration-300 border border-gray-700">
						View All Projects
						<svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
						</svg>
					</a>
				</div>
			</div>
		</div>
	</AnimatedSection>

	<!-- Connect Section (Twingate-inspired styling) -->
	<AnimatedSection client:load id="connect" className="py-20 relative overflow-hidden">
		<div class="absolute inset-0 z-0">
			<div class="absolute top-1/3 right-1/3 w-96 h-96 bg-indigo-500/5 rounded-full blur-[80px]"></div>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="max-w-5xl mx-auto">
				<div class="text-left mb-16">
					<div class="text-xs font-medium text-primary uppercase tracking-wider mb-3">Connect</div>
					<h2 class="text-3xl md:text-4xl font-bold text-white mb-5">Let's collaborate on<br />your next project</h2>
					<p class="text-gray-400 max-w-2xl">
						I'm always interested in discussing new projects, creative ideas, or opportunities to be part of your vision
					</p>
				</div>

				<div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-8 md:p-12">
					<div class="flex flex-col md:flex-row gap-10 items-center">
						<div class="flex-1">
							<h3 class="text-2xl font-bold text-white mb-5">Ready to collaborate?</h3>
							<p class="text-gray-400 mb-8">I'm always open to discussing new projects, creative ideas, or opportunities to be part of your vision.</p>

							<div class="flex flex-wrap gap-4">
								{socialLinks.map(link => (
									<a
										href={link.url}
										aria-label={link.name}
										target={link.name !== 'Email' ? '_blank' : undefined}
										rel={link.name !== 'Email' ? 'noopener noreferrer' : undefined}
										class="flex items-center gap-2 px-4 py-2 bg-gray-700 hover:bg-gray-600 rounded-lg transition-colors duration-300 text-white group"
										>
