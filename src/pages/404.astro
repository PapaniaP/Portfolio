---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import { Image } from 'astro:assets';
---

<Layout title="Design in Progress">
  <!-- Grid background from index page -->
  <div class="fixed inset-0 z-[-1] opacity-5">
    <div class="h-full w-full bg-[linear-gradient(#374151_0.7px,transparent_0.7px),linear-gradient(to_right,#374151_0.7px,transparent_0.7px)] [background-size:64px_64px]"></div>
  </div>

  <div class="min-h-screen flex flex-col items-center justify-center px-6 py-12 relative">
    <div class="container max-w-3xl mx-auto text-center relative z-10">
      <!-- UX/UI Designer focused heading -->
      <div class="mb-8 relative">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold text-text-primary mb-6">
          Under Construction
        </h1>
        <div class="h-px w-32 bg-brand-primary/50 mx-auto mb-2"></div>
      </div>

      <!-- Virgil font message related to UX/UI design -->
      <div class="mb-12">
        <h2 class="logo-font text-2xl md:text-3xl mb-5 text-brand-primary">
          This page is still in the making
        </h2>
        <p class="text-lg text-text-secondary leading-relaxed max-w-xl mx-auto mb-6">
          As a UX/UI designer and frontend developer, I believe in iterative improvement. This section of my portfolio is still in the wireframing stage and will be implemented soon.
        </p>

        <!-- Design Process Timeline - Responsive implementation -->
        <div class="design-timeline py-8 md:py-10 relative overflow-hidden">
          <!-- Desktop Timeline View -->
          <div class="hidden md:grid md:grid-cols-4 gap-4 lg:gap-6 w-full max-w-4xl mx-auto px-4 relative z-10">
            {[
              {
                title: "Research",
                description: "Understanding",
                icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
                state: "completed"
              },
              {
                title: "Wireframe",
                description: "Structure",
                icon: "M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z",
                state: "completed"
              },
              {
                title: "Design",
                description: "Visuals",
                icon: "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01",
                state: "completed"
              },
              {
                title: "Develop",
                description: "Building",
                icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
                state: "in-progress"
              }
            ].map(step => (
              <div class={`timeline-step ${step.state} flex flex-col items-center justify-start gap-4 transition-all duration-300 hover:bg-brand-primary/5 p-2 rounded-lg`}>
                <div class="step-icon relative">
                  <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={step.icon} />
                  </svg>
                  {step.state === "in-progress" && <div class="icon-pulse"></div>}
                </div>
                <div class="step-content text-center">
                  <h3 class="step-title">{step.title}</h3>
                  <p class="step-description">{step.description}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Mobile View - Simplified Progress Bar -->
          <div class="md:hidden w-3/4 max-w-sm mx-auto">
          <div class="bg-surface rounded-full h-2.5 mb-6">
              <div class="bg-brand-primary h-2.5 rounded-full w-3/4" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
            </div>

            <div class="text-center">
              <div class="inline-flex items-center justify-center mb-3">
                <div class="w-3 h-3 bg-brand-primary rounded-full mr-2"></div>
                <span class="text-brand-primary font-medium">Progress: 3/4 Complete</span>
              </div>
              <p class="text-text-secondary text-sm">Currently in the development phase</p>

              <!-- Current stage indicator -->
              <div class="mt-4 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
                <span class="text-xs font-medium">Development Stage</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation buttons with proper icon implementation -->
      <div class="flex flex-col sm:flex-row justify-center items-center gap-6 mt-12 mb-6">
        <Button href="/" variant="primary" size="md" class="min-w-[160px]" icon="home">
          Home
        </Button>
        <Button variant="outline" size="md" onclick="history.back()" class="min-w-[160px]" icon="arrow-left">
          Back
        </Button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .design-timeline {
    position: relative;
  }

  .design-timeline::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-border);
    transform: translateY(-50%);
    z-index: 1;
  }

  .timeline-step {
    position: relative;
    z-index: 2;
  }

  .timeline-step .step-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .timeline-step.completed .step-icon {
    background-color: var(--color-brand-primary);
    border-color: var(--color-brand-primary);
    color: var(--color-text-inverted);
  }

  .timeline-step.in-progress .step-icon {
    background-color: var(--color-brand-primary-light);
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .step-title {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-text-primary);
  }

  .step-description {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .icon-pulse {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-brand-primary);
    opacity: 0.15;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      transform: translate(-50%, -50%) scale(0.8);
      opacity: 0.4;
    }
    50% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.2;
    }
    100% {
      transform: translate(-50%, -50%) scale(0.8);
      opacity: 0.4;
    }
  }

  /* Make timeline elements more visible on tablet/mobile */
  @media (max-width: 768px) {
    .timeline-step {
      padding: 1rem;
    }
  }
</style>