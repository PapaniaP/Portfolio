---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Button from '../components/ui/Button.astro';
---

<Layout title="404 - Page Not Found">
  <div class="min-h-screen flex flex-col items-center justify-center px-4 py-24">
    <div class="relative w-full max-w-3xl mx-auto">
      <!-- Animated stars background -->
      <div class="absolute inset-0 overflow-hidden -z-10">
        <div class="stars-container">
          <div class="stars"></div>
          <div class="stars2"></div>
          <div class="stars3"></div>
        </div>
      </div>

      <div class="text-center">
        <h1 class="text-9xl font-bold text-white relative inline-block">
          <span class="absolute -inset-2 blur-xl bg-primary/30 rounded-full -z-10"></span>
          404
        </h1>

        <div class="mt-6 mb-12 relative">
          <div class="absolute top-1/2 left-0 w-full h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div>
          <h2 class="text-3xl md:text-4xl font-medium text-white relative inline-block bg-black/80 px-4">Page Not Found</h2>
        </div>

        <div class="floating-astronaut relative w-40 h-40 mx-auto my-8">
          <div class="absolute inset-0 rounded-full bg-primary/10 animate-pulse"></div>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-full text-white"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              d="M12 2L8 7H16L12 2Z"
              fill="currentColor"
              stroke="currentColor"
              stroke-width="1"
            />
            <rect
              x="9"
              y="8"
              width="6"
              height="9"
              fill="currentColor"
              stroke="currentColor"
              stroke-width="1"
            />
            <path
              d="M8 10H5V13H8"
              stroke="currentColor"
              stroke-width="2"
            />
            <path
              d="M16 10H19V13H16"
              stroke="currentColor"
              stroke-width="2"
            />
            <path
              d="M10 17L9 22H11L10.5 17"
              fill="currentColor"
              stroke="currentColor"
            />
            <path
              d="M14 17L15 22H13L13.5 17"
              fill="currentColor"
              stroke="currentColor"
            />
          </svg>
        </div>

        <p class="text-xl text-gray-300 mb-8 max-w-xl mx-auto">
          It seems you've drifted into uncharted space. The page you're looking for has been lost to the cosmic void.
        </p>

        <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
          <Button
            href="/"
            variant="primary"
            size="lg"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Return Home
          </Button>

          <Button
            variant="outline"
            size="lg"
            onclick="history.back()"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Go Back
          </Button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Stars animation */
  .stars-container {
    position: absolute;
    width: 100%;
    height: 100%;
    transform: rotateZ(45deg);
  }

  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    background: transparent;
    box-shadow:
      1449px 1457px #fff, 1px 1256px #fff, 149px 557px #fff,
      1049px 57px #fff, 49px 357px #fff, 549px 1657px #fff,
      949px 457px #fff, 1150px 1150px #fff, 850px 950px #fff,
      650px 750px #fff, 450px 550px #fff, 250px 350px #fff,
      1650px 1750px #fff, 1450px 1550px #fff, 1250px 1350px #fff;
    animation: animStar 50s linear infinite;
  }

  .stars2 {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 2px;
    background: transparent;
    box-shadow:
      1200px 1200px #fff, 200px 200px #fff, 1000px 1000px #fff,
      1800px 1800px #fff, 800px 800px #fff, 600px 600px #fff,
      400px 400px #fff, 700px 1300px #fff, 1500px 500px #fff;
    animation: animStar 100s linear infinite;
  }

  .stars3 {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 3px;
    background: transparent;
    box-shadow:
      500px 500px #fff, 1500px 1500px #fff, 700px 700px #fff,
      1700px 1700px #fff, 900px 900px #fff, 1900px 1900px #fff,
      1100px 1100px #fff, 1300px 1300px #fff, 300px 300px #fff;
    animation: animStar 150s linear infinite;
  }

  .floating-astronaut {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes animStar {
    from {
      transform: translateY(0px);
    }
    to {
      transform: translateY(-2000px);
    }
  }

  @keyframes float {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(5deg);
    }
    100% {
      transform: translateY(0px) rotate(0deg);
    }
  }
</style>