---
import GalleryLayout from '../../layouts/GalleryLayout.astro';
import MasonicGallery from '../../components/ui/MasonicGallery.jsx';
import { Image } from 'astro:assets';

// Import Harmony UI images
import harmonyUICover from '../../assets/projects/raskrask/harmony/harmonyUI-cover.webp';

// Use additional images from other projects for demonstration
import image1 from '../../assets/projects/raskrask/recharge/recharge-cover.webp';
import image2 from '../../assets/projects/raskrask/recharge/research/domain-workshop.webp';
import image3 from '../../assets/Images/avatar.png';

const galleryItems = [
  {
    src: harmonyUICover.src,
    alt: "Harmony UI Component Library",
    width: harmonyUICover.width,
    height: harmonyUICover.height,
    description: "A comprehensive design system with reusable components and pattern library for consistent user experience across RaskRask platforms."
  },
  {
    src: image1.src,
    alt: "Harmony UI Mobile Design",
    width: image1.width,
    height: image1.height,
    description: "Responsive mobile interface designs following the Harmony design language, optimized for touch interactions."
  },
  {
    src: image2.src,
    alt: "Harmony UI Design Workshop",
    width: image2.width,
    height: image2.height,
    description: "Collaborative workshop session with stakeholders to define the core principles and visual direction of the Harmony UI system."
  },
  {
    src: image3.src,
    alt: "Harmony UI User Experience Persona",
    width: image3.width,
    height: image3.height,
    description: "User persona development to ensure the design system addresses the needs of both internal developers and end users."
  },
  {
    src: harmonyUICover.src, // Using cover again for variety
    alt: "Harmony UI Development Guidelines",
    width: harmonyUICover.width,
    height: harmonyUICover.height,
    description: "Technical documentation and implementation guidelines for frontend developers working with the Harmony component library."
  }
];
---

<GalleryLayout title="Harmony UI Gallery" description="A visual showcase of the Harmony UI design system and its components. Explore the UI kit, patterns, and creative solutions developed for RaskRask's digital products.">
  <section class="mb-12">
    <MasonicGallery items={galleryItems} gap={24} client:only="react" />
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6">Design Principles</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-secondary p-6 rounded-lg">
        <h3 class="text-xl font-semibold mb-3">Consistency</h3>
        <p>Unified design language across all touchpoints ensures a cohesive user experience.</p>
      </div>
      <div class="bg-secondary p-6 rounded-lg">
        <h3 class="text-xl font-semibold mb-3">Accessibility</h3>
        <p>Designed with WCAG guidelines in mind to ensure inclusive experiences for all users.</p>
      </div>
      <div class="bg-secondary p-6 rounded-lg">
        <h3 class="text-xl font-semibold mb-3">Flexibility</h3>
        <p>Adaptable components that work across different devices, screen sizes, and contexts.</p>
      </div>
    </div>
  </section>

  <!-- Lightbox modal with description -->
  <div id="gallery-lightbox" class="fixed inset-0 z-50 bg-black/90 items-center justify-center p-4" style="display: none;">
    <button id="close-lightbox" class="absolute top-4 right-4 text-white p-2 rounded-full bg-black/50 hover:bg-black/70 transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <div class="max-w-screen-xl max-h-screen flex flex-col items-center">
      <div class="relative max-h-[80vh] overflow-hidden">
        <img id="lightbox-img" src="" alt="" class="mx-auto max-h-[80vh] max-w-full rounded-lg shadow-2xl" />
      </div>
      <!-- Image description container -->
      <div id="lightbox-description" class="mt-4 bg-black/50 rounded-lg p-4 max-w-2xl text-center opacity-90">
        <h3 id="lightbox-title" class="text-white text-lg font-medium mb-1"></h3>
        <p id="lightbox-desc" class="text-white/90 text-sm"></p>
      </div>
    </div>
  </div>
</GalleryLayout>

<script>
  // Function to handle opening the lightbox (called from React component)
  function openGalleryLightbox(src: string, alt: string, description?: string): void {
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxDesc = document.getElementById('lightbox-desc');

    if (lightboxImg && src) {
      // Set image
      lightboxImg.src = src;
      lightboxImg.alt = alt || '';

      // Set description
      if (lightboxTitle && lightboxDesc) {
        lightboxTitle.textContent = alt || '';
        lightboxDesc.textContent = description || '';
      }

      // Show lightbox
      if (lightbox) {
        lightbox.style.display = 'flex';
      }
      document.body.classList.add('overflow-hidden');
    }
  }

  // Function to handle closing the lightbox
  function closeGalleryLightbox(): void {
    const lightbox = document.getElementById('gallery-lightbox');
    if (lightbox) {
      lightbox.style.display = 'none';
    }
    document.body.classList.remove('overflow-hidden');
  }

  // Initialize lightbox closing functionality
  function initLightboxControls(): void {
    const lightbox = document.getElementById('gallery-lightbox');
    const closeBtn = document.getElementById('close-lightbox');

    // Close lightbox on button click
    closeBtn?.addEventListener('click', closeGalleryLightbox);

    // Close lightbox on click outside the image
    lightbox?.addEventListener('click', (e: Event) => {
      if (e.target === lightbox) {
        closeGalleryLightbox();
      }
    });

    // Close on escape key
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && lightbox?.style.display === 'flex') {
        closeGalleryLightbox();
      }
    });

    // Expose the open function to the window scope so React can call it
    window.openGalleryLightbox = openGalleryLightbox;
  }

  // Initialize when DOM is loaded
  document.addEventListener('DOMContentLoaded', initLightboxControls);

  // For Astro view transitions, also initialize when the navigation is complete
  document.addEventListener('astro:page-load', initLightboxControls);
</script>

<script>
  // TypeScript interface declaration - separate from runtime code
  interface Window {
    openGalleryLightbox: (src: string, alt: string, description?: string) => void;
  }
</script>
