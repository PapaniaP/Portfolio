<script>
  declare global {
    interface Window {
      openGalleryLightbox: (src: string, alt: string) => void;
    }
  }

  function openGalleryLightbox(src: string, alt: string) {
    const modal = document.createElement('div');
    modal.className = 'fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm';

    const img = document.createElement('img');
    img.src = src;
    img.alt = alt;
    img.className = 'max-h-[90vh] max-w-[90vw] object-contain rounded-xl shadow-2xl';

    modal.appendChild(img);

    modal.addEventListener('click', () => {
      modal.remove();
    });

    document.body.appendChild(modal);
  }

  // Add the lightbox functionality to the window object
  window.openGalleryLightbox = openGalleryLightbox;

  // Function to apply lightbox to images
  function applyLightboxToImages() {
    // Get all case study content sections
    const caseStudyContainer = document.querySelector('.max-w-7xl.xl\\:max-w-8xl.mx-auto');
    if (!caseStudyContainer) return;

    // Get all images in the case study sections, except for small icons and already handled gallery images
    const allImages = caseStudyContainer.querySelectorAll('img:not(.masonic *)');
    let count = 0;

    allImages.forEach(img => {
      const imgElement = img as HTMLImageElement;

      // Skip very small images (likely icons) and images in the navigation
      if (imgElement.closest('nav') ||
          imgElement.closest('header') ||
          imgElement.width < 100 ||
          imgElement.height < 100 ||
          imgElement.closest('.masonic')) {
        return;
      }

      // Make the image itself clickable
      imgElement.classList.add('cursor-pointer', 'hover:opacity-95', 'transition-opacity', 'duration-200');

      // Add click handler directly to the image only
      imgElement.addEventListener('click', (e) => {
        e.stopPropagation(); // Prevent event bubbling
        window.openGalleryLightbox(imgElement.src, imgElement.alt);
      });

      count++;
    });

    console.log('Lightbox applied to', count, 'images');
  }

  // Run on window load to ensure all images are loaded and sized properly
  window.addEventListener('load', applyLightboxToImages);
</script>

