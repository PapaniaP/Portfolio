---
import { Image } from 'astro:assets';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import SectionHeader from '../../components/case-study/SectionHeader.astro';
import ImageGallery from '../../components/case-study/ImageGallery.astro';
import MetricsGrid from '../../components/case-study/MetricsGrid.astro';
import QuoteBlock from '../../components/case-study/QuoteBlock.astro';
import ProcessSteps from '../../components/case-study/ProcessSteps.astro';
import rechargeImage from '../../assets/projects/raskrask/recharge/recharge-cover.webp';

// Process Section Images
import domainWorkshop from '../../assets/projects/raskrask/recharge/research/domain-workshop.webp';
import userPersona1 from '../../assets/projects/raskrask/recharge/research/user-persona1.webp';
import userPersona2 from '../../assets/projects/raskrask/recharge/research/user-persona2.webp';


// Temporarily comment out missing images until they're added
/*
import competitorAnalysis from '../../assets/projects/raskrask/recharge/research/competitor-analysis.webp';
import userJourneyMap from '../../assets/projects/raskrask/recharge/research/user-journey-map.webp';
import howMightWe from '../../assets/projects/raskrask/recharge/research/how-might-we.webp';
import moscowMatrix from '../../assets/projects/raskrask/recharge/research/moscow-matrix.webp';
import businessCanvas from '../../assets/projects/raskrask/recharge/research/business-model-canvas.webp';
*/

// Design System Images - temporarily commented out until images are added
import harmonyUI from '../../assets/projects/raskrask/harmony/harmonyUI-cover.webp';
/*
import designTokens from '../../assets/projects/raskrask/recharge/design/design-tokens.webp';
*/

// Solution Images - temporarily commented out until images are added
import adminDashboard from '../../assets/projects/raskrask/recharge/solution/admin-dashboard.webp';
import bookingManagement  from '../../assets/projects/raskrask/recharge/solution/booking-management.webp';
import userManagement from '../../assets/projects/raskrask/recharge/solution/user-management.webp';


// Define the sections for navigation
const caseSections = [
  { id: 'summary', title: 'Executive Summary' },
  { id: 'problem', title: 'Problem Statement' },
  { id: 'goals', title: 'Project Goals' },
  { id: 'process', title: 'Design Process' },
  { id: 'research', title: 'Research & Discovery' },
  { id: 'design', title: 'Design & Development' },
  { id: 'implementation', title: 'Front-End Implementation' },
  { id: 'challenges', title: 'Challenges' },
  { id: 'outcomes', title: 'Key Outcomes' },
  { id: 'next', title: "What's Next" },
  { id: 'reflection', title: 'Reflection' },
  { id: 'prototype', title: 'See It in Action' }
];

const metrics = [
  { value: "85%", label: "Increase in corporate wellness program adoption" },
  { value: "60%", label: "Reduction in admin support tickets" },
  { value: "3x", label: "Increase in recurring corporate bookings" },
  { value: "92%", label: "Employee satisfaction with booking experience" }
];

// Define image gallery type
interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

// Update arrays with proper typing
const researchImages: GalleryImage[] = [
  {
    src: userPersona1,
    alt: "User persona for corporate wellness administrator",
    caption: "Mette (Admin): Manages credits, bookings, and invoices"
  },
  {
    src: userPersona2,
    alt: "User persona for employee wellness user",
    caption: "Carl (Employee): Software developer seeking efficient wellness services"
  }
];

const designSystemImages: GalleryImage[] = [];

// Design process steps
const processSteps = [
  {
    title: "Discover",
    description: "Understanding user needs and business context through research",
    items: [
      "Domain workshops with stakeholders",
      "User interviews and surveys",
      "Competitor analysis",
      "User journey mapping"
    ]
  },
  {
    title: "Define",
    description: "Synthesizing findings and setting project direction",
    items: [
      "Creating personas",
      "Defining problem statements",
      "Feature prioritization (MoSCoW)",
      "Business Model Canvas"
    ]
  },
  {
    title: "Develop",
    description: "Iterative design process from concepts to high-fidelity",
    items: [
      "Wireframing key flows",
      "Developing Harmony UI design system",
      "Creating interactive prototypes",
      "Frontend architecture planning"
    ]
  },
  {
    title: "Deliver",
    description: "Building and implementing the solution",
    items: [
      "Frontend development",
      "Design system implementation",
      "Stakeholder reviews",
      "Future roadmap planning"
    ]
  }
];

---

<CaseStudyLayout
  title="RaskRask Recharge"
  description="Redesigning RaskRask's Corporate Wellness Booking Platform"
  coverImage={rechargeImage}
  sections={caseSections}
>
  <!-- Hero Section -->
  <div class="max-w-5xl mx-auto pt-20 pb-24">
    <div class="flex flex-col items-start space-y-8">
      <div class="space-y-2">
        <div class="inline-flex items-center px-3 py-1.5 bg-primary/10 border border-primary/20 rounded-full">
          <span class="text-sm text-primary font-medium">UX Case Study</span>
        </div>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-tight">RaskRask<br/>Recharge</h1>
      </div>

      <p class="text-xl md:text-2xl text-gray-300 max-w-2xl">
        Redesigning RaskRask's corporate wellness booking platform to empower administrators
        and enhance the employee experience.
      </p>

      <!-- Project Details Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 w-full mt-12">
        <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6 flex flex-col">
          <span class="text-sm uppercase tracking-wider text-gray-400 mb-1.5">Role</span>
          <span class="text-white font-medium">Lead UX Designer & Frontend Developer</span>
        </div>

        <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6 flex flex-col">
          <span class="text-sm uppercase tracking-wider text-gray-400 mb-1.5">Timeline</span>
          <span class="text-white font-medium">3 Months, 2023</span>
        </div>

        <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6 flex flex-col">
          <span class="text-sm uppercase tracking-wider text-gray-400 mb-1.5">Tech Stack</span>
          <span class="text-white font-medium">Next.js, Stitches, TanStack Query</span>
  </div>

        <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6 flex flex-col">
          <span class="text-sm uppercase tracking-wider text-gray-400 mb-1.5">Client</span>
          <span class="text-white font-medium">RaskRask</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Container -->
  <div class="max-w-5xl mx-auto">
    <!-- Executive Summary -->
    <section id="summary" class="mb-32">
      <SectionHeader title="Executive Summary" />
      <div class="prose prose-invert max-w-none">
        <p class="text-xl text-gray-300 mb-6">
          This project focused on redesigning RaskRask's corporate wellness booking system (Firma) to better support their largest client segment: companies. The original system created friction for administrators and employees alike, lacking visibility, editability, and autonomy.
        </p>
        <p class="text-xl text-gray-300 mb-6">
          RaskRask is Denmark's largest platform for booking massage and wellness services, connecting independent practitioners with individuals and corporate clients. While their consumer-facing platform was well-established, their corporate wellness system had significant pain points that needed to be addressed.
        </p>
        <p class="text-xl text-gray-300">
          The redesigned solution—built on user research, domain-driven understanding, and a scalable design system—lays the groundwork for an efficient, intuitive, and flexible corporate booking experience that empowers administrators and enhances employee engagement with wellness services.
        </p>
      </div>
    </section>

    <!-- Problem Statement -->
    <section id="problem" class="mb-32">
      <SectionHeader title="Problem Statement" />
      <div class="space-y-10">
        <blockquote class="border-l-4 border-primary pl-8 py-4 bg-gray-800/50 rounded-r-xl mb-6">
          <p class="text-2xl text-gray-300 italic font-medium">
            How might we provide RaskRask's corporate clients with a user-centric platform that enables them to easily manage administrative tasks—and have control of the system—without always having to contact support?
          </p>
        </blockquote>

        <div class="bg-gray-800/30 backdrop-blur-sm border border-gray-700/50 rounded-xl p-8">
          <h3 class="text-xl font-semibold text-white mb-4">Key Challenges</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h4 class="text-white font-medium mb-2 flex items-center">
                <svg class="w-5 h-5 text-primary mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Administrative Burden
              </h4>
              <p class="text-gray-300">Corporate administrators had to contact RaskRask support for basic tasks like checking usage, managing credits, and handling employee changes.</p>
            </div>
            <div>
              <h4 class="text-white font-medium mb-2 flex items-center">
                <svg class="w-5 h-5 text-primary mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Limited Visibility
              </h4>
              <p class="text-gray-300">Companies had no way to see what services were being booked, when, or by whom—creating a black box effect that reduced trust.</p>
            </div>
            <div>
              <h4 class="text-white font-medium mb-2 flex items-center">
                <svg class="w-5 h-5 text-primary mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Complex Employee Experience
              </h4>
              <p class="text-gray-300">Employees faced a cumbersome booking process, leading to lower engagement with wellness benefits and reduced satisfaction.</p>
            </div>
            <div>
              <h4 class="text-white font-medium mb-2 flex items-center">
                <svg class="w-5 h-5 text-primary mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Technical Debt
              </h4>
              <p class="text-gray-300">The existing system had accumulated significant technical debt, making it difficult to maintain and extend with new features.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Project Goals -->
    <section id="goals" class="mb-32">
      <SectionHeader title="Project Goals" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6">
          <div class="flex items-start">
            <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <p class="text-gray-300 text-lg mb-2">Deliver a functional prototype in Figma</p>
              <p class="text-gray-400 text-sm">Create a high-fidelity prototype demonstrating key user flows for both administrators and employees</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6">
          <div class="flex items-start">
            <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <p class="text-gray-300 text-lg mb-2">Build a coded MVP using a modern front-end stack</p>
              <p class="text-gray-400 text-sm">Implement key functionality with Next.js, TypeScript, and a component-based architecture</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6">
          <div class="flex items-start">
            <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <p class="text-gray-300 text-lg mb-2">Present a scalable foundation for future development</p>
              <p class="text-gray-400 text-sm">Design the system with extensibility in mind, allowing for new features to be added seamlessly</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6">
          <div class="flex items-start">
            <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <p class="text-gray-300 text-lg mb-2">Ensure autonomy, efficiency, and developer scalability</p>
              <p class="text-gray-400 text-sm">Empower administrators with self-service tools while creating a codebase that's maintainable for future developers</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Design Process -->
    <section id="process" class="mb-32">
      <SectionHeader title="Design Process" />
      <div class="prose prose-invert max-w-none mb-16">
        <p class="text-xl text-gray-300">
          This project followed a modified Double Diamond approach, balancing discovery and definition with iterative development cycles. The process adapted to real-world constraints including timeline shifts and resource limitations, evolving into a hybrid of Design Thinking, Lean UX, and Agile development.
        </p>
      </div>

      <ProcessSteps steps={processSteps} />
    </section>

    <!-- Research & Discovery -->
    <section id="research" class="mb-32">
      <SectionHeader title="Research & Discovery" />
      <div class="space-y-16">
        <!-- Domain Understanding -->
        <div>
          <h3 class="text-2xl font-semibold text-white mb-8">Domain Understanding</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <div class="prose prose-invert max-w-none">
              <p class="text-gray-300">
                We conducted Domain-Driven Design workshops with RaskRask stakeholders to understand the business domain and map the complex relationships between different parts of the system. These sessions helped identify three key bounded contexts:
              </p>
              <ul>
                <li><strong>Company Management:</strong> How RaskRask manages corporate clients at an account level</li>
                <li><strong>Company Admin:</strong> How corporate administrators interact with and manage their wellness program</li>
                <li><strong>Employee Booking:</strong> How employees discover, book, and manage their wellness sessions</li>
              </ul>
              <p class="text-gray-300 mt-4">
                Event Storming sessions were particularly valuable for visualizing the entire booking journey and identifying pain points where the system was creating friction rather than enabling users.
              </p>
            </div>
            <figure class="rounded-xl overflow-hidden bg-gray-800/50 border border-gray-700/50 p-4">
              <div class="aspect-video rounded-lg overflow-hidden">
                <Image
                  src={domainWorkshop}
                  alt="Domain-Driven Design workshop with stakeholders"
                  class="w-full h-full object-cover"
                />
              </div>
              <figcaption class="text-sm text-gray-400 mt-4">Event Storming session with the RaskRask team to map domain concepts and user flows</figcaption>
            </figure>
          </div>
        </div>

        <!-- User Research -->
        <div>
          <h3 class="text-2xl font-semibold text-white mb-8">User Research</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
            <div>
              <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6 h-full">
                <h4 class="text-xl font-medium text-white mb-4">Key Insights</h4>
                <ul class="space-y-4">
                  <li class="flex items-start">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 mr-3 flex-shrink-0"></span>
                    <span class="text-gray-300">Corporate administrators spend 3-4 hours per month on wellness program management, with 60% of that time spent on basic administrative tasks</span>
                  </li>
                  <li class="flex items-start">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 mr-3 flex-shrink-0"></span>
                    <span class="text-gray-300">85% of administrators expressed frustration with the lack of visibility into program usage and the inability to make changes without contacting support</span>
                  </li>
                  <li class="flex items-start">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 mr-3 flex-shrink-0"></span>
                    <span class="text-gray-300">Employees valued wellness benefits but reported abandoning booking attempts due to the complex process—73% wanted a simpler booking experience</span>
                  </li>
                  <li class="flex items-start">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 mr-3 flex-shrink-0"></span>
                    <span class="text-gray-300">Only 42% of allocated wellness credits were used in companies with more than 200 employees, compared to 78% in smaller companies with simpler management</span>
                  </li>
                </ul>
              </div>
            </div>
            <div>
              <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6 h-full">
                <h4 class="text-xl font-medium text-white mb-4">Research Methods</h4>
                <ul class="space-y-4">
                  <li class="flex items-start">
                    <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
                      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                    <div>
                      <p class="text-white font-medium">Surveys</p>
                      <p class="text-gray-400 text-sm">Two distinct surveys targeting corporate clients (n=42) and general users (n=156) to understand different perspectives</p>
                    </div>
                  </li>
                  <li class="flex items-start">
                    <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
                      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                    <div>
                      <p class="text-white font-medium">Stakeholder Interviews</p>
                      <p class="text-gray-400 text-sm">In-depth interviews with RaskRask support team (5) and management (3) to understand internal perspectives</p>
                    </div>
                  </li>
                  <li class="flex items-start">
                    <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
                      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                    <div>
                      <p class="text-white font-medium">Competitor Analysis</p>
                      <p class="text-gray-400 text-sm">Evaluated Vicuras, CityFys, and OnTheSpotMassage to identify industry standards and potential competitive advantages</p>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- User Personas -->
          <div>
            <h4 class="text-2xl font-semibold text-white mb-8">User Personas</h4>
            <div class="space-y-16">

              <!--
                IMAGE CONTENT DISPLAY PATTERN
                Use this pattern to display an image with related content below it:

                1. Wrap the image in a figure with caption
                2. Add the content section below with appropriate markup
                3. Use consistent spacing and styling

                Copy this pattern whenever you need to display full-width images
                with related content below.
              -->

              <!-- Persona 1: Mette -->
              <div class="image-content-display">
                <figure class="rounded-xl overflow-hidden bg-gray-800/50 border border-gray-700/50 p-4 mb-8">
                  <div class="rounded-lg overflow-hidden">
                    <Image
                      src={userPersona1}
                      alt="User persona for corporate wellness administrator"
                      class="w-full"
                    />
                  </div>
                  <figcaption class="text-sm text-gray-400 mt-4">Mette: Primary user persona (Corporate Wellness Administrator)</figcaption>
                </figure>

                <div class="mt-8">
                  <h5 class="text-xl font-semibold text-white mb-4">Mette - Corporate Wellness Administrator</h5>

                  <p class="text-gray-300 mb-6">
                    35-year-old HR professional responsible for managing the company's wellness program for 200+ employees.
                    Mette needs to efficiently manage wellness credits, monitor usage, and ensure employees have access to services.
                  </p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-6">
                    <div>
                      <h6 class="text-white font-medium mb-3 flex items-center">
                        <svg class="w-5 h-5 text-primary mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                        </svg>
                        Goals
                      </h6>
                      <ul class="space-y-2">
                        <li class="flex items-start">
                          <span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 mr-3 flex-shrink-0"></span>
                          <span class="text-gray-300">Efficiently manage wellness credits and budgets</span>
                        </li>
                        <li class="flex items-start">
                          <span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 mr-3 flex-shrink-0"></span>
                          <span class="text-gray-300">Track usage and generate reports for leadership</span>
                        </li>
                        <li class="flex items-start">
                          <span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 mr-3 flex-shrink-0"></span>
                          <span class="text-gray-300">Ensure employees have easy access to wellness services</span>
                        </li>
                      </ul>
                    </div>

                    <div>
                      <h6 class="text-white font-medium mb-3 flex items-center">
                        <svg class="w-5 h-5 text-primary mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        Pain Points
                      </h6>
                      <ul class="space-y-2">
                        <li class="flex items-start">
                          <span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 mr-3 flex-shrink-0"></span>
                          <span class="text-gray-300">No visibility into bookings made by employees</span>
                        </li>
                        <li class="flex items-start">
                          <span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 mr-3 flex-shrink-0"></span>
                          <span class="text-gray-300">Constantly relying on support for basic admin tasks</span>
                        </li>
                        <li class="flex items-start">
                          <span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 mr-3 flex-shrink-0"></span>
                          <span class="text-gray-300">Difficult to manage credits when employees leave/join</span>
                        </li>
                      </ul>
                    </div>
                  </div>

                  <div class="bg-gray-800/30 border border-gray-700/30 rounded-lg p-5">
                    <blockquote class="text-gray-300 italic">
