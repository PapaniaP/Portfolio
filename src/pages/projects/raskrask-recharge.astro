          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-text-secondary">•</span>
              <span class="text-text-secondary">User testing</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-text-secondary">•</span>
              <span class="text-text-secondary">Stakeholder review</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-text-secondary">•</span>
