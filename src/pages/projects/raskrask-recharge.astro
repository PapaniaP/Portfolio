          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-text-secondary">•</span>
              <span class="text-text-secondary">Confusing booking process</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-text-secondary">•</span>
              <span class="text-text-secondary">Unclear treatment availability</span>
            </li>
            <li class="flex items-start gap-3">
