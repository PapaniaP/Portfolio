            </li>
            <li class="flex items-start gap-3">
              <span class="text-text-secondary">•</span>
              <span class="text-text-secondary">UI components</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-text-secondary">•</span>
              <span class="text-text-secondary">Prototyping</span>
            </li>
          </ul>
        </div>

        <div class="bg-surface border border-border-primary rounded-xl p-6 shadow-card-light">
