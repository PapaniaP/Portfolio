            <li class="flex items-start gap-3">
              <span class="text-text-secondary">•</span>
              <span class="text-text-secondary">User personas</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-text-secondary">•</span>
              <span class="text-text-secondary">Journey mapping</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-text-secondary">•</span>
              <span class="text-text-secondary">Problem framing</span>
            </li>
