---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Button from '../components/ui/Button.astro';
// Import your profile image - replace with actual path when available
import profileImage from '../assets/profile/profile.webp';

const skills = [
    {
        category: "UX/UI Design",
        items: ["User Research", "Wireframing", "Prototyping", "Usability Testing", "Information Architecture", "Figma", "Product Design", "Design Systems"]
    },
    {
        category: "Frontend Development",
        items: ["HTML", "CSS", "JavaScript", "React", "Astro", "TailwindCSS", "Version Control"]
    },
    {
        category: "Tools & Other",
        items: ["Git", "WordPress", "Firebase", "Agile Methodologies", "User Testing", "Design Thinking", "Interaction Design"]
    }
];

// Add your education details
const education = [
    {
        degree: "Digital Concept Development",
        institution: "Business Academy Aarhus",
        year: "2024-Present",
        description: "Currently pursuing advanced studies in digital concept development, focusing on creating innovative digital solutions and product strategies."
    },
    {
        degree: "Multimedia Design",
        institution: "Business Academy Aarhus",
        year: "2022-2024",
        description: "Focused on UX/UI design, web development, and digital communication strategies. Developed strong foundation in user-centered design principles and frontend development."
    }
];

// Add your work experience
const experience = [
    {
        position: "Frontend Developer & UX/UI Designer",
        company: "RaskRask",
        period: "2024 (6 month internship)",
        description: "Collaborated with the development team on frontend implementation and UX/UI design for a wellness service provider. Contributed to responsive web solutions and user-centered design improvements using modern technologies."
    },
    {
        position: "Freelance Designer",
        company: "Self-employed",
        period: "2022-Present",
        description: "Providing UX/UI design services for various clients, focusing on creating intuitive and engaging digital experiences."
    }
];

---

<Layout title="About Me" description="Learn more about Paolo Papania - UX/UI Designer and Frontend Developer based in Aarhus, Denmark.">
    <div class="container mx-auto px-4 py-20">
        <div class="max-w-4xl mx-auto">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-8 animate-fadeIn">
                About Me
            </h1>

            <!-- Bio Section -->
            <div class="grid md:grid-cols-2 gap-12 mb-16 animate-fadeIn animation-delay-100">
                <div class="order-2 md:order-1">
                    <h2 class="text-2xl font-bold text-white mb-4 bg-gradient-to-r from-primary to-primary-light bg-clip-text text-transparent">
                        Hello, I'm Paolo Papania
                    </h2>
                    <div class="space-y-4 text-gray-300">
                        <p>
                            I'm a UX/UI Designer with frontend development skills based in Aarhus, Denmark. I'm passionate about creating intuitive, accessible, and user-centered digital experiences that solve real problems.
                        </p>
                        <p>
                            Currently pursuing Digital Concept Development at Business Academy Aarhus, I combine my design thinking with technical knowledge to create comprehensive digital solutions that prioritize user needs while meeting business objectives.
                        </p>
                        <p>
                            My approach to design is deeply rooted in understanding user behavior and needs, always striving to create experiences that are both functional and delightful to use.
                        </p>
                        <div class="mt-8">
                            <a
                                href="/cv.pdf"
                                class="inline-flex items-center px-5 py-3 bg-gradient-to-r from-primary to-primary-light text-white rounded-lg hover:shadow-glow-sm transition-all"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                Download CV
                            </a>
                        </div>
                    </div>
                </div>
                <div class="order-1 md:order-2">
                    <div class="relative group">
                        <!-- Decorative elements -->
                        <div class="absolute -top-3 -left-3 w-12 h-12 border-t-2 border-l-2 border-primary-light opacity-70"></div>
                        <div class="absolute -bottom-3 -right-3 w-12 h-12 border-b-2 border-r-2 border-primary opacity-70"></div>

                        <!-- Gradient overlay -->
                        <div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-10 rounded-xl"></div>

                        <!-- Image container -->
                        <div class="bg-gray-800/60 rounded-xl overflow-hidden shadow-glow-md border border-gray-700">
                            <Image
                                src={profileImage}
                                alt="Paolo Papania"
                                width={600}
                                height={800}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                            />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Skills Section -->
            <div class="mb-16 animate-fadeIn animation-delay-200">
                <h2 class="text-2xl font-bold text-white mb-6 inline-flex items-center">
                    <span class="bg-gradient-to-r from-primary to-primary-light bg-clip-text text-transparent">Skills & Expertise</span>
                    <div class="ml-3 h-px w-20 bg-gradient-to-r from-primary to-transparent"></div>
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {skills.map((skillGroup, index) => (
                        <div class="bg-gray-800/60 backdrop-blur-sm rounded-xl overflow-hidden shadow-glow-sm hover:shadow-glow-md transition-all duration-300 border border-gray-700 group"
                            style={`animation-delay: ${200 + (index * 100)}ms`}>
                            <!-- Gradient header -->
                            <div class="bg-gradient-to-r from-primary to-primary-light/70 p-4 group-hover:from-primary-light group-hover:to-primary transition-all duration-500">
                                <h3 class="text-xl font-semibold text-white">
                                    {skillGroup.category}
                                </h3>
                            </div>
                            <div class="p-6">
                                <ul class="space-y-3">
                                    {skillGroup.items.map((skill) => (
                                        <li class="flex items-center">
                                            <svg class="w-5 h-5 text-primary-light mr-2 transition-transform duration-300 group-hover:scale-110" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                            </svg>
                                            <span class="text-gray-300">{skill}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Education & Experience -->
            <div class="grid md:grid-cols-2 gap-12 mb-16 animate-fadeIn animation-delay-300">
                <!-- Education -->
                <div>
                    <h2 class="text-2xl font-bold text-white mb-6 inline-flex items-center">
                        <span class="bg-gradient-to-r from-primary to-primary-light bg-clip-text text-transparent">Education</span>
                        <div class="ml-3 h-px w-20 bg-gradient-to-r from-primary to-transparent"></div>
                    </h2>
                    <div class="space-y-8">
                        {education.map((item, index) => (
                            <div class="relative pl-8 border-l-2 border-gray-700 group" style={`animation-delay: ${300 + (index * 100)}ms`}>
                                <div class="absolute w-4 h-4 bg-gradient-to-r from-primary to-primary-light rounded-full -left-[9px] top-1 shadow-glow-sm group-hover:shadow-glow-md transition-all duration-300"></div>
                                <h3 class="text-xl font-semibold text-white group-hover:text-primary-light transition-colors duration-300">
                                    {item.degree}
                                </h3>
                                <p class="text-primary-light mb-1">
                                    {item.institution}
                                </p>
                                <p class="text-sm text-gray-500 mb-2">
                                    {item.year}
                                </p>
                                <p class="text-gray-300">
                                    {item.description}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Experience -->
                <div>
                    <h2 class="text-2xl font-bold text-white mb-6 inline-flex items-center">
                        <span class="bg-gradient-to-r from-primary to-primary-light bg-clip-text text-transparent">Experience</span>
                        <div class="ml-3 h-px w-20 bg-gradient-to-r from-primary to-transparent"></div>
                    </h2>
                    <div class="space-y-8">
                        {experience.map((item, index) => (
                            <div class="relative pl-8 border-l-2 border-gray-700 group" style={`animation-delay: ${300 + (index * 100)}ms`}>
                                <div class="absolute w-4 h-4 bg-gradient-to-r from-primary to-primary-light rounded-full -left-[9px] top-1 shadow-glow-sm group-hover:shadow-glow-md transition-all duration-300"></div>
                                <h3 class="text-xl font-semibold text-white group-hover:text-primary-light transition-colors duration-300">
                                    {item.position}
                                </h3>
                                <p class="text-primary-light mb-1">
                                    {item.company}
                                </p>
                                <p class="text-sm text-gray-500 mb-2">
                                    {item.period}
                                </p>
                                <p class="text-gray-300">
                                    {item.description}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Personal Interests -->
            <div class="mb-16 animate-fadeIn animation-delay-400">
                <h2 class="text-2xl font-bold text-white mb-6 inline-flex items-center">
                    <span class="bg-gradient-to-r from-primary to-primary-light bg-clip-text text-transparent">Beyond Work</span>
                    <div class="ml-3 h-px w-20 bg-gradient-to-r from-primary to-transparent"></div>
                </h2>
                <div class="bg-gray-800/60 backdrop-blur-sm rounded-xl p-8 border border-gray-700 shadow-glow-sm overflow-hidden relative">
                    <!-- Decorative gradient accent -->
                    <div class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-bl from-primary/20 to-transparent rounded-bl-full -z-1"></div>

                    <div class="text-gray-300 space-y-4 relative z-10">
                        <p>
                            When I'm not designing or coding, you can find me immersed in video games or cheering for my favorite rugby team. I'm also passionate about ergonomic computing, using a custom low-profile Ferris Sweep split keyboard as my daily driver.
                        </p>
                        <p>
                            My interest in technology extends beyond the screen – I enjoy exploring how hardware and software can work together to create better user experiences, whether that's through ergonomic keyboard layouts or intuitive interface design.
                        </p>
                        <p>
                            At home, I share my space with my cat, who occasionally serves as my unofficial design critic during late-night coding sessions.
                        </p>
                    </div>

                    <!-- Fun interactive element -->
                    <div class="mt-12 relative z-10">
                        <div class="fun-fact-terminal">
                            <!-- Terminal Header -->
                            <div class="terminal-header">
                                <div class="terminal-buttons">
                                    <span class="terminal-button close"></span>
                                    <span class="terminal-button minimize"></span>
                                    <span class="terminal-button zoom"></span>
                                </div>
                                <div class="terminal-title">fun_facts.sh</div>
                            </div>

                            <!-- Terminal Content -->
                            <div class="terminal-content">
                                <div class="command-line">
                                    <span class="prompt">visitor@portfolio</span>
                                    <span class="separator">:</span>
                                    <span class="directory">~/fun-facts</span>
                                    <span class="separator">$</span>
                                    <span class="command">get_random_fact</span>
                                </div>
                                <div class="output-line">
                                    <span class="output-prefix">[OUTPUT] </span>
                                    <span id="fun-fact" class="fact-text">I use a custom low-profile Ferris Sweep split keyboard, which has helped me maintain better ergonomics while coding.</span>
                                </div>
                                <div class="command-line">
                                    <Button
                                        id="new-fact-btn"
                                        variant="terminal"
                                        size="sm"
                                    >
                                        $ generate_new_fact
                                    </Button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact CTA -->
            <div class="text-center animate-fadeIn animation-delay-500">
                <h2 class="text-2xl font-bold text-white mb-4 bg-gradient-to-r from-primary to-primary-light bg-clip-text text-transparent inline-block">
                    Let's Connect
                </h2>
                <p class="text-gray-300 mb-6">
                    Interested in working together or just want to say hello?
                </p>
                <Button
                    href="/#contact-section"
                    variant="primary"
                    size="lg"
                >
                    Get in Touch
                </Button>
            </div>
        </div>
    </div>

    <script>
        // Fun facts array - update with your own facts
        const funFacts = [
            "I'm South African and proud Springboks supporter - currently playing rugby for Aarhus Rugby Klub (ARK).",
            "I've been teaching English for 7 years, starting as a full-time teacher and now continuing part-time alongside my UX career.",
            "My keyboard collection includes 7 different boards, including two Ferris Sweeps, an A.dux, a Tipper-TF, a Corne, a Planck, and a 65%.",
            "I'm a big fan of roguelikes/lites - currently alternating between Hades and Darkest Dungeon 2, with some Call of Duty when I need a shooter fix.",
            "My daily driver is a 34-key split Ferris Sweep - proving you don't need many keys to be productive!"
        ];

        // Fun fact switcher
        const newFactBtn = document.getElementById('new-fact-btn');
        const factElement = document.getElementById('fun-fact');

        if (newFactBtn && factElement) {
            newFactBtn.addEventListener('click', () => {
                let newFact: string;
                const currentFact = factElement.textContent?.trim() || '';

                // Make sure we don't repeat the current fact
                do {
                    newFact = funFacts[Math.floor(Math.random() * funFacts.length)];
                } while (newFact === currentFact);

                // Add fade-out effect
                factElement.style.opacity = '0';

                // Change text and fade back in
                setTimeout(() => {
                    factElement.textContent = newFact;
                    factElement.style.opacity = '1';
                }, 300);
            });
        }
    </script>
</Layout>

<style>
    /* Terminal Styles */
    .fun-fact-terminal {
        background-color: #1a1b26;
        border-radius: 8px;
        box-shadow: 0 0 20px rgba(88, 209, 255, 0.15),
                    0 0 40px rgba(88, 209, 255, 0.1);
        font-family: 'JetBrains Mono', monospace;
        overflow: hidden;
        border: 1px solid rgba(88, 209, 255, 0.2);
    }

    .terminal-header {
        background: #1f2335;
        padding: 8px 16px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(88, 209, 255, 0.2);
    }

    .terminal-buttons {
        display: flex;
        gap: 8px;
        margin-right: 16px;
    }

    .terminal-button {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

    .terminal-button.close {
        background: #ff5f56;
    }

    .terminal-button.minimize {
        background: #ffbd2e;
    }

    .terminal-button.zoom {
        background: #27c93f;
    }

    .terminal-title {
        color: #7aa2f7;
        font-size: 14px;
        opacity: 0.8;
    }

    .terminal-content {
        padding: 20px;
        color: #a9b1d6;
    }

    .command-line {
        margin: 12px 0;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 4px;
    }

    .prompt {
        color: #9ece6a;
    }

    .separator {
        color: #7aa2f7;
    }

    .directory {
        color: #7dcfff;
    }

    .command {
        color: #bb9af7;
        margin-left: 8px;
    }

    .output-line {
        margin: 16px 0;
        padding: 12px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
        border-left: 3px solid #7aa2f7;
    }

    .output-prefix {
        color: #7aa2f7;
        font-weight: bold;
    }

    .fact-text {
        color: #c0caf5;
        margin-left: 8px;
        opacity: 1;
        transition: opacity 0.3s ease;
    }
</style>