---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Button from '../components/ui/Button.astro';
// Import your profile image - replace with actual path when available
import profileImage from '../assets/profile/profile.webp';

const skills = [
    {
        category: "UX/UI Design",
        items: ["User Research", "Wireframing", "Prototyping", "Usability Testing", "Information Architecture", "Figma", "Product Design", "Design Systems"]
    },
    {
        category: "Frontend Development",
        items: ["HTML", "CSS", "JavaScript", "React", "Next.js", "Astro", "TailwindCSS", "Version Control"]
    },
    {
        category: "Tools & Other",
        items: ["Git", "WordPress", "Firebase", "Agile Methodologies", "User Testing", "Design Thinking", "Interaction Design"]
    }
];

// Add your education details
const education = [
    {
        degree: "Digital Concept Development",
        institution: "Business Academy Aarhus",
        year: "2024-Present",
        description: "Currently pursuing advanced studies in digital concept development, focusing on creating innovative digital solutions and product strategies."
    },
    {
        degree: "Multimedia Design",
        institution: "Business Academy Aarhus",
        year: "2022-2024",
        description: "Focused on UX/UI design, web development, and digital communication strategies. Developed strong foundation in user-centered design principles and frontend development."
    }
];

// Add your work experience
const experience = [
    {
        position: "Frontend Developer & UX/UI Designer",
        company: "RaskRask",
        period: "2024 (6 month internship)",
        description: "Collaborated with the development team on frontend implementation and UX/UI design for a wellness service provider. Contributed to responsive web solutions and user-centered design improvements using modern technologies."
    },
    {
        position: "Freelance Designer",
        company: "Self-employed",
        period: "2022-Present",
        description: "Providing UX/UI design services for various clients, focusing on creating intuitive and engaging digital experiences."
    }
];

---

<Layout title="About Me" description="Learn more about Paolo Papania - UX/UI Designer and Frontend Developer based in Aarhus, Denmark.">
    <div class="container mx-auto px-4 py-20">
        <div class="max-w-4xl mx-auto">
            <h1 class="text-4xl md:text-5xl tracking-tight font-bold font-display text-text-primary mb-8 animate-fadeIn">
                About Me
            </h1>

            <!-- Bio Section -->
            <div class="grid md:grid-cols-2 gap-12 mb-16 animate-fadeIn animation-delay-100">
                <div class="order-2 md:order-1">
                    <h2 class="text-2xl font-bold text-text-secondary mb-4 ">
                        Hello, I'm <span class="font-virgil  text-brand-primary/80 ml-1">Paolo Papania</span>
                    </h2>
                    <div class="space-y-4 text-text-secondary">
                        <p>
                           I'm a designer and developer based in Aarhus, Denmark, driven by a passion for untangling complex problems and crafting digital experiences that feel intuitive and genuinely useful. My journey started in teaching English, which unexpectedly honed my skills in empathy and clear communication – skills I now bring to UX design.
                        </p>
                        <p>
                            Currently deepening my knowledge in Digital Concept Development at Business Academy Aarhus, I blend strategic thinking with hands-on frontend skills (React, Next.js, Astro are my current favorites). I thrive on understanding the 'why' behind user actions and translating those insights into designs that are not only functional but also a pleasure to interact with.
                        </p>
                        <p>
                           When I'm not designing or coding, you might find me optimizing my ergonomic setup (ask me about my split keyboard!), strategizing in a roguelike, or cheering on the Springboks.
                        </p>

                    </div>
                </div>
                <div class="order-1 md:order-2">
                    <div class="relative group">
                        <!-- Removed decorative corner elements -->
                        <!-- Gradient overlay -->
                        <div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-10 rounded-xl"></div>

                        <!-- Image container - Standardized card style -->
                        <div class="bg-surface/80 backdrop-blur-sm rounded-xl overflow-hidden shadow-card-light hover:shadow-card-hover transition-shadow duration-300">
                            <Image
                                src={profileImage}
                                alt="Paolo Papania"
                                width={600}
                                height={800}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                            />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Skills Section -->
            <div class="mb-16 animate-fadeIn animation-delay-200">
                <h2 class="text-3xl font-semibold text-text-primary mb-8 pb-2 border-b border-border-secondary">
                    Skills & Expertise
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {skills.map((skillGroup, index) => (
                        <div class="bg-surface/80 backdrop-blur-sm rounded-xl p-6 shadow-card-light hover:shadow-card-hover transition-shadow duration-300"
                            style={`animation-delay: ${200 + (index * 100)}ms`}>
                            <h3 class="text-xl font-semibold text-text-primary mb-4">
                                {skillGroup.category}
                            </h3>
                            <ul class="space-y-2">
                                {skillGroup.items.map((skill) => (
                                    <li class="flex items-center text-text-secondary">
                                        <svg class="w-4 h-4 text-brand-primary mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                          </svg>
                                        <span>{skill}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Education & Experience -->
            <div class="grid md:grid-cols-2 gap-6 mb-16 animate-fadeIn animation-delay-300">
                <!-- Education Card -->
                <div class="bg-surface/80 backdrop-blur-sm rounded-xl p-6 shadow-card-light hover:shadow-card-hover transition-shadow duration-300">
                    <h2 class="text-2xl font-semibold text-text-primary mb-6 pb-2 border-b border-border-secondary">
                        Education
                    </h2>
                    <div class="space-y-6">
                        {education.map((item) => (
                            <div>
                                <h3 class="text-lg font-semibold text-text-primary">
                                    {item.degree}
                                </h3>
                                <p class="text-brand-primary-light text-sm mb-1">
                                    {item.institution}
                                </p>
                                <p class="text-xs text-text-muted mb-2">
                                    {item.year}
                                </p>
                                <p class="text-text-secondary text-sm">
                                    {item.description}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Experience Card -->
                <div class="bg-surface/80 backdrop-blur-sm rounded-xl p-6 shadow-card-light hover:shadow-card-hover transition-shadow duration-300">
                    <h2 class="text-2xl font-semibold text-text-primary mb-6 pb-2 border-b border-border-secondary">
                        Experience
                    </h2>
                    <div class="space-y-6">
                        {experience.map((item) => (
                            <div>
                                <h3 class="text-lg font-semibold text-text-primary">
                                    {item.position}
                                </h3>
                                <p class="text-brand-primary-light text-sm mb-1">
                                    {item.company}
                                </p>
                                <p class="text-xs text-text-muted mb-2">
                                    {item.period}
                                </p>
                                <p class="text-text-secondary text-sm">
                                    {item.description}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Personal Interests -->
            <div class="mb-16 animate-fadeIn animation-delay-400">
                <h2 class="text-3xl font-semibold text-text-primary mb-8 pb-2 border-b border-border-secondary">
                    Beyond Work
                </h2>
                <!-- Standardized card style, adjusted padding -->
                <div class="bg-surface/80 backdrop-blur-sm rounded-xl p-6 shadow-card-light hover:shadow-card-hover transition-shadow duration-300 overflow-hidden relative">
                    <!-- Decorative gradient accent - Kept unique style -->
                    <div class="absolute top-0 right-0 w-40 h-40 bg-gradient-primary/20 rounded-bl-full -z-1"></div>

                    <div class="text-text-secondary space-y-4 relative z-10">
                        <p>
                            When I'm not designing or coding, you can find me immersed in video games or cheering for my favorite rugby team. I'm also passionate about ergonomic computing, using a custom low-profile Ferris Sweep split keyboard as my daily driver.
                        </p>
                        <p>
                            My interest in technology extends beyond the screen – I enjoy exploring how hardware and software can work together to create better user experiences, whether that's through ergonomic keyboard layouts or intuitive interface design.
                        </p>
                        <p>
                            At home, I share my space with my cat, who occasionally serves as my unofficial design critic during late-night coding sessions.
                        </p>
                    </div>


                </div>
                 <!-- Fun interactive element - Kept unique style -->
                 <div class="mt-12 relative z-10">
                    <div class="fun-fact-terminal">
                        <!-- Terminal Header -->
                        <div class="terminal-header">
                            <div class="terminal-buttons">
                                <span class="terminal-button close"></span>
                                <span class="terminal-button minimize"></span>
                                <span class="terminal-button zoom"></span>
                            </div>
                            <div class="terminal-title">fun_facts.sh</div>
                        </div>

                        <!-- Terminal Content -->
                        <div class="terminal-content">
                            <div class="command-line">
                                <span class="prompt">visitor@portfolio</span>
                                <span class="separator">:</span>
                                <span class="directory">~/fun-facts</span>
                                <span class="separator">$</span>
                                <span class="command">get_random_fact</span>
                            </div>
                            <div class="output-line">
                                <span class="output-prefix">[OUTPUT] </span>
                                <span id="fun-fact" class="fact-text">I use a custom low-profile Ferris Sweep split keyboard, which has helped me maintain better ergonomics while coding.</span>
                            </div>
                            <div class="command-line">
                                <Button
                                    id="new-fact-btn"
                                    variant="terminal"
                                    size="sm"
                                >
                                    $ generate_new_fact
                                </Button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Fun facts array - update with your own facts
        const funFacts = [
            "I'm South African and proud Springboks supporter - currently playing rugby for Aarhus Rugby Klub (ARK).",
            "I've been teaching English for 7 years, starting as a full-time teacher and now continuing part-time alongside my UX career.",
            "My keyboard collection includes 7 different boards, including two Ferris Sweeps, an A.dux, a Tipper-TF, a Corne, a Planck, and a 65%.",
            "I'm a big fan of roguelikes/lites - currently alternating between Hades and Darkest Dungeon 2, with some Call of Duty when I need a shooter fix.",
            "My daily driver is a 34-key split Ferris Sweep - proving you don't need many keys to be productive!"
        ];

        // Fun fact switcher
        const newFactBtn = document.getElementById('new-fact-btn');
        const factElement = document.getElementById('fun-fact');

        if (newFactBtn && factElement) {
            newFactBtn.addEventListener('click', () => {
                let newFact: string;
                const currentFact = factElement.textContent?.trim() || '';

                // Make sure we don't repeat the current fact
                do {
                    newFact = funFacts[Math.floor(Math.random() * funFacts.length)];
                } while (newFact === currentFact);

                // Add fade-out effect
                factElement.style.opacity = '0';

                // Change text and fade back in
                setTimeout(() => {
                    factElement.textContent = newFact;
                    factElement.style.opacity = '1';
                }, 300);
            });
        }
    </script>
</Layout>

<style>
    /* Terminal Styles */
    .fun-fact-terminal {
        background-color: #1a1b26;
        border-radius: 8px;
        box-shadow: 0 0 20px rgba(88, 209, 255, 0.15),
                    0 0 40px rgba(88, 209, 255, 0.1);
        font-family: 'JetBrains Mono', monospace;
        overflow: hidden;
        border: 1px solid rgba(88, 209, 255, 0.2);
    }

    .terminal-header {
        background: #1f2335;
        padding: 8px 16px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(88, 209, 255, 0.2);
    }

    .terminal-buttons {
        display: flex;
        gap: 8px;
        margin-right: 16px;
    }

    .terminal-button {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

    .terminal-button.close {
        background: #ff5f56;
    }

    .terminal-button.minimize {
        background: #ffbd2e;
    }

    .terminal-button.zoom {
        background: #27c93f;
    }

    .terminal-title {
        color: #7aa2f7;
        font-size: 14px;
        opacity: 0.8;
    }

    .terminal-content {
        padding: 20px;
        color: #a9b1d6;
    }

    .command-line {
        margin: 12px 0;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 4px;
    }

    .prompt {
        color: #9ece6a;
    }

    .separator {
        color: #7aa2f7;
    }

    .directory {
        color: #7dcfff;
    }

    .command {
        color: #bb9af7;
        margin-left: 8px;
    }

    .output-line {
        margin: 16px 0;
        padding: 12px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
        border-left: 3px solid #7aa2f7;
    }

    .output-prefix {
        color: #7aa2f7;
        font-weight: bold;
    }

    .fact-text {
        color: #c0caf5;
        margin-left: 8px;
        opacity: 1;
        transition: opacity 0.3s ease;
    }
</style>