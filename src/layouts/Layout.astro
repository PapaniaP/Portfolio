---
import Button from '../components/ui/Button.astro';
import '../css/style.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Paolo Papania's Portfolio - Frontend Developer and UX/UI Designer showcasing creative web development projects"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />

		<!-- Open Graph / Social Media -->
		<meta property="og:title" content={`${title} | Paolo Papania`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/images/avatar.png" />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Favicon -->
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />


		<title>{title} | Paolo Papania</title>
	</head>
	<body class="min-h-screen text-text-primary font-sans">
		<!-- Skip to main content link for accessibility -->
		<a href="#main-content" class="sr-only focus:not-sr-only p-4 m-4 rounded text-text-primary font-semibold absolute top-0 left-0 z-[100]">
			Skip to main content
		</a>

		<header class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-md border-b border-border-primary">
			<div class="container mx-auto px-6 md:px-8 py-4">
				<nav class="flex items-center justify-between">
					<div class="flex items-center gap-8">
						<a href="/" class="text-xl font-display font-bold text-text-inverted flex items-center">
							<span class="logo-font bg-brand-primary/20 py-2 px-3 rounded text-text-secondary mr-2">Papi.</span>

						</a>
						<ul class="hidden md:flex items-center gap-8">
							<li><a href="/" class="text-text-secondary hover:text-brand-primary transition-colors duration-300 text-sm font-medium">Home</a></li>
							<li><a href="/about" class="text-text-secondary hover:text-brand-primary transition-colors duration-300 text-sm font-medium">About</a></li>
							<li><a href="/projects" class="text-text-secondary hover:text-brand-primary transition-colors duration-300 text-sm font-medium">Projects</a></li>
							<li><a href="/cv_Paolo.pdf" class="text-text-secondary hover:text-brand-primary transition-colors duration-300 text-sm font-medium" target="_blank" rel="noopener noreferrer">CV</a></li>
						</ul>
					</div>

					<div class="flex items-center gap-4">
						<Button
							href="mailto:papaniap11@gmail.com"
							variant="primary"
							size="sm"
							class="hidden sm:flex items-center"
						>
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
							</svg>
							Contact
						</Button>
						<button id="menu-toggle" class="md:hidden text-text-secondary" aria-label="Toggle menu">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
							</svg>
						</button>
					</div>
				</nav>
			</div>

			<!-- Mobile menu -->
			<div id="mobile-menu" class="hidden md:hidden bg-surface border-t border-border-primary">
				<div class="container mx-auto px-4 py-2">
					<ul class="py-2 space-y-2">
						<li><a href="/" class="block py-2 text-text-secondary hover:text-brand-primary">Home</a></li>
						<li><a href="/about" class="block py-2 text-text-secondary hover:text-brand-primary">About</a></li>
						<li><a href="/projects" class="block py-2 text-text-secondary hover:text-brand-primary">Projects</a></li>
						<li><a href="/cv_Paolo.pdf" class="block py-2 text-text-secondary hover:text-brand-primary" target="_blank" rel="noopener noreferrer">CV</a></li>
					</ul>
				</div>
			</div>
		</header>

		<main id="main-content" class="pt-16 relative">
			<!-- Global background elements - Adjusted to use theme colors -->
			<div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
				{/* Use theme colors for gradient blobs */}
				<div class="absolute top-0 right-0 w-[45rem] h-[45rem] bg-gradient-to-br from-brand-primary/5 to-brand-accent/5 rounded-full blur-[120px]"></div>
				<div class="absolute bottom-0 left-0 w-[35rem] h-[35rem] bg-gradient-to-tr from-brand-primary/5 to-brand-accent/5 rounded-full blur-[100px]"></div>
				<!-- Subtle dot pattern (uses border-secondary, should be fine with theme) -->
				<div class="absolute inset-0 opacity-5">
					<div class="h-full w-full bg-[radial-gradient(theme(colors.border-secondary)_1px,transparent_1px)] [background-size:16px_16px]"></div>
				</div>
			</div>

			<slot />
		</main>

		<footer class="mt-20 py-12 bg-surface border-t border-border-primary relative z-10">
			<div class="container mx-auto px-6 md:px-8">
				<div class="flex flex-col md:flex-row justify-between items-center gap-8 pb-8 border-b border-border-secondary">
					<div class="flex items-center gap-2">
						<div class="w-8 h-8 bg-brand-primary/10 rounded-lg flex items-center justify-center">
							<svg class="w-5 h-5 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
							</svg>
						</div>
						<span class="text-text-primary font-medium">Paolo Papania</span>
					</div>

					<nav class="flex flex-wrap justify-center gap-6 md:gap-8">
						<a href="/" class="text-text-secondary hover:text-brand-primary transition-colors">Home</a>
						<a href="/projects" class="text-text-secondary hover:text-brand-primary transition-colors">Projects</a>
						<a href="/about" class="text-text-secondary hover:text-brand-primary transition-colors">About</a>
						<a href="/#contact-section" class="text-text-secondary hover:text-brand-primary transition-colors">Contact</a>
					</nav>

					<div class="flex gap-4">
						<a href="https://github.com/PapaniaP" target="_blank" rel="noopener noreferrer" class="w-8 h-8 bg-surface rounded-lg flex items-center justify-center text-text-secondary hover:bg-brand-primary/10 hover:text-brand-primary transition-all" aria-label="GitHub">
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.73.083-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/>
							</svg>
						</a>
						<a href="mailto:papaniap11@gmail.com" class="w-8 h-8 bg-surface rounded-lg flex items-center justify-center text-text-secondary hover:bg-brand-primary/10 hover:text-brand-primary transition-all" aria-label="Email">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
							</svg>
						</a>
						<a href="https://linkedin.com/in/paolo-papania" target="_blank" rel="noopener noreferrer" class="w-8 h-8 bg-surface rounded-lg flex items-center justify-center text-text-secondary hover:bg-brand-primary/10 hover:text-brand-primary transition-all" aria-label="LinkedIn">
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
						</a>
					</div>
				</div>

				<div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
					<div class="text-sm text-text-muted">
						© {new Date().getFullYear()} Paolo Papania. All rights reserved.
					</div>
					<div class="text-xs text-text-muted">
						Designed and built by Paolo Papania
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Mobile menu toggle
			const menuToggle = document.getElementById('menu-toggle');
			const mobileMenu = document.getElementById('mobile-menu');

			if (menuToggle && mobileMenu) {
				menuToggle.addEventListener('click', () => {
					mobileMenu.classList.toggle('hidden');
				});
			}

			// Intersection Observer for scroll animations
			const observerOptions = {
				root: null, // relative to the viewport
				rootMargin: '0px',
				threshold: 0.2 // Trigger when 20% of the element is visible (matches Framer Motion setting)
			};

			/**
			 * Intersection Observer Callback
			 * @param {IntersectionObserverEntry[]} entries
			 * @param {IntersectionObserver} observer
			 */
			const observerCallback = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
				entries.forEach((entry: IntersectionObserverEntry) => {
					if (entry.isIntersecting) {
						// Use type assertion for classList access
						(entry.target as HTMLElement).classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			};

			const observer = new IntersectionObserver(observerCallback, observerOptions);

			const targets = document.querySelectorAll('.animate-on-scroll');
			targets.forEach(target => {
				observer.observe(target);
			});

		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}

	/* Custom scrollbar for dark mode */
	::-webkit-scrollbar {
		width: 8px;
	}

	::-webkit-scrollbar-track {
		background: hsl(var(--color-background)); /* Use background color */
	}

	::-webkit-scrollbar-thumb {
		background: hsl(var(--color-border-secondary)); /* Use a slightly darker border color */
		border-radius: 4px;
	}

	::-webkit-scrollbar-thumb:hover {
		background: hsl(var(--color-brand-primary)); /* Use brand color on hover */
	}
</style>
