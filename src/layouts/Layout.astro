---
import Button from '../components/ui/Button.astro';
import '../css/style.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Paolo Papania's Portfolio - Frontend Developer and UX/UI Designer showcasing creative web development projects"
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />

		<!-- Open Graph / Social Media -->
		<meta property="og:title" content={`${title} | Paolo Papania`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/images/avatar.png" />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Favicon -->
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />


		<title>{title} | Paolo Papania</title>
	</head>
	<body class="min-h-screen flex flex-col text-text-primary font-sans">
		<!-- Skip to main content link for accessibility -->
		<a href="#main-content" class="sr-only focus:not-sr-only p-4 m-4 rounded text-text-primary font-semibold absolute top-0 left-0 z-[100]">
			Skip to main content
		</a>

		<header class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-md border-b border-border-primary">
			<div class="container mx-auto px-6 md:px-8 py-4">
				<nav class="flex items-center justify-between">
					<div class="flex items-center gap-8">
						<a href="/" class="text-xl font-display font-bold text-text-inverted flex items-center">
							<span class="logo-font py-2 px-3 mr-2">Papi.</span>
						</a>
						<ul class="hidden md:flex items-center gap-8">
							<li><a href="/" class="nav-link text-text-secondary hover:text-brand-primary transition-colors duration-300 text-base font-medium relative pb-1" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
							<li><a href="/about" class="nav-link text-text-secondary hover:text-brand-primary transition-colors duration-300 text-base font-medium relative pb-1" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a></li>
							<li><a href="/projects" class="nav-link text-text-secondary hover:text-brand-primary transition-colors duration-300 text-base font-medium relative pb-1" aria-current={currentPath === '/projects' ? 'page' : undefined}>Projects</a></li>
							<li><a href="/cv_Paolo.pdf" class="nav-link text-text-secondary hover:text-brand-primary transition-colors duration-300 text-base font-medium relative pb-1" target="_blank" rel="noopener noreferrer">CV</a></li>
						</ul>
					</div>

					<div class="flex items-center gap-4">
						<Button
							href="#footer-contact"
							variant="primary"
							size="sm"
							class="hidden sm:flex items-center"
							icon="send"
						>
							Contact
						</Button>
						<Button
							id="menu-toggle"
							variant="ghost"
							size="icon"
							icon="menu"
							class="md:hidden text-text-secondary"
							aria-label="Toggle menu"
						/>
					</div>
				</nav>
			</div>

			<!-- Mobile menu -->
			<div id="mobile-menu" class="hidden md:hidden bg-surface border-t border-border-primary">
				<div class="container mx-auto px-4 py-2">
					<ul class="py-2 space-y-2">
						<li><a href="/" class="block py-2 text-text-secondary hover:text-brand-primary">Home</a></li>
						<li><a href="/about" class="block py-2 text-text-secondary hover:text-brand-primary">About</a></li>
						<li><a href="/projects" class="block py-2 text-text-secondary hover:text-brand-primary">Projects</a></li>
						<li><a href="/cv_Paolo.pdf" class="block py-2 text-text-secondary hover:text-brand-primary" target="_blank" rel="noopener noreferrer">CV</a></li>
						<li class="pt-2 mt-2 border-t border-border-primary">
							<Button
								href="#footer-contact"
								variant="primary"
								size="md"
								class="w-full justify-center"
								onClick="document.getElementById('mobile-menu').classList.add('hidden');"
								icon="send"
							>
								Contact Me
							</Button>
						</li>
					</ul>
				</div>
			</div>
		</header>

		<main id="main-content" class="pt-16 relative flex-grow">
			<!-- Global background elements - Adjusted to use theme colors -->
			<div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
				{/* Use theme colors for gradient blobs */}
				<div class="absolute top-0 right-0 w-[45rem] h-[45rem] bg-gradient-to-br from-brand-primary/5 to-brand-accent/5 rounded-full blur-[120px]"></div>
				<div class="absolute bottom-0 left-0 w-[35rem] h-[35rem] bg-gradient-to-tr from-brand-primary/5 to-brand-accent/5 rounded-full blur-[100px]"></div>
				<!-- Subtle dot pattern (uses border-secondary, should be fine with theme) -->
				<div class="absolute inset-0 opacity-5">
					<div class="h-full w-full bg-[radial-gradient(theme(colors.border-secondary)_1px,transparent_1px)] [background-size:16px_16px]"></div>
				</div>
			</div>

			<slot />
		</main>

		<footer id="footer-contact" class="mt-20 py-16 bg-[hsl(225,15%,22%)] text-gray-300 relative z-10">
			<div class="container mx-auto px-6 md:px-8">
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16 items-start">
					<!-- Left Column: CTA Text & Status -->
					<div class="lg:col-span-2 text-center lg:text-left">
						<h2 class="text-5xl lg:text-6xl font-extrabold font-display text-white mb-4 tracking-tighter leading-tight">
							Let's Create.
						</h2>
						<p class="text-lg text-gray-300 max-w-2xl mb-8">
							Have an idea or want to collaborate? Let's build something amazing together. Reach out and start the conversation.
						</p>
						<div class="inline-flex items-center px-4 py-2 bg-brand-primary/25  rounded-full">
							<div class="w-2 h-2 bg-green-400 rounded-full animate-pulse mr-3"></div>
							<span class="text-sm text-brand-primary-light">Looking for fall internship</span>
						</div>
					</div>

					<!-- Right Column: Contact Card, Nav & Copyright -->
					<div class="lg:col-span-1 flex flex-col gap-8 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none">
						<!-- Contact Card -->
						<div id="contact-card" class="bg-[hsl(225,15%,25%)] shadow-lg border border-white/10 rounded-xl p-6 transition-all duration-500">
							<div class="flex flex-col gap-6">
								<a href="mailto:papaniap11@gmail.com" class="group flex items-center gap-4 transition-all duration-300 hover:scale-[1.02]">
									<div class="w-12 h-12 rounded-xl bg-brand-primary/25 flex items-center justify-center flex-shrink-0 transition-colors duration-300 group-hover:bg-brand-primary/30">

										<svg class="w-6 h-6 text-brand-primary-light group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
										</svg>
									</div>
									<div>
										<div class="text-sm text-gray-400 group-hover:text-gray-200 transition-colors">Email me at</div>
										<div class="text-gray-200 group-hover:text-white transition-colors">papaniap11@gmail.com</div>
									</div>
								</a>

								<a href="https://linkedin.com/in/papaniap" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 transition-all duration-300 hover:scale-[1.02]">
									<div class="w-12 h-12 rounded-xl bg-brand-primary/25 flex items-center justify-center flex-shrink-0 transition-colors duration-300 group-hover:bg-brand-primary/30">
										<svg class="w-6 h-6 text-brand-primary-light group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
											<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
										</svg>
									</div>
									<div>
										<div class="text-sm text-gray-400 group-hover:text-gray-200 transition-colors">Connect on</div>
										<div class="text-gray-200 group-hover:text-white transition-colors">LinkedIn</div>
									</div>
								</a>

								<a href="https://github.com/PapaniaP" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 transition-all duration-300 hover:scale-[1.02]">
									<div class="w-12 h-12 rounded-xl bg-brand-primary/25 flex items-center justify-center flex-shrink-0 transition-colors duration-300 group-hover:bg-brand-primary/30">
										<svg class="w-6 h-6 text-brand-primary-light group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
											<path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.73.083-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/>
										</svg>
									</div>
									<div>
										<div class="text-sm text-gray-400 group-hover:text-gray-200 transition-colors">Follow on</div>
										<div class="text-gray-200 group-hover:text-white transition-colors">GitHub</div>
									</div>
								</a>
							</div>
						</div>

					</div>
				</div>
				<!-- Navigation & Copyright -->
				<div class="flex flex-col sm:flex-row justify-between items-center gap-6 pt-8 mt-10 border-t border-white/10 w-full text-sm">
					<nav class="flex flex-wrap justify-center sm:justify-start gap-x-6 gap-y-2 text-gray-400">
						<a href="/" class="hover:text-white transition-colors" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
						<a href="/about" class="hover:text-white transition-colors" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a>
						<a href="/projects" class="hover:text-white transition-colors" aria-current={currentPath === '/projects' ? 'page' : undefined}>Projects</a>
						<a href="/cv_Paolo.pdf" class="hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">CV</a>
					</nav>
					<div class="text-xs text-gray-500 text-center sm:text-right whitespace-nowrap">
						© {new Date().getFullYear()} Paolo Papania
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Mobile menu toggle
			const menuToggle = document.getElementById('menu-toggle');
			const mobileMenu = document.getElementById('mobile-menu');

			if (menuToggle && mobileMenu) {
				menuToggle.addEventListener('click', () => {
					mobileMenu.classList.toggle('hidden');
				});
			}

			// Contact card highlight function
			const contactButtons = document.querySelectorAll('a[href="#footer-contact"], button[href="#footer-contact"]');
			const contactCard = document.getElementById('contact-card');

			if (contactButtons.length && contactCard) {
				contactButtons.forEach(button => {
					button.addEventListener('click', () => {
						// Remove highlight if it exists (to allow re-triggering)
						contactCard.classList.remove('highlighted');

						// Force a reflow so the removal is processed before adding again
						void contactCard.offsetWidth;

						// Add the highlight class
						contactCard.classList.add('highlighted');

						// Make the card focusable and focus it for accessibility
						contactCard.setAttribute('tabindex', '-1');
						setTimeout(() => {
							contactCard.focus();
						}, 500); // Wait for scroll to complete

						// Remove the highlight after 3.5 seconds (2.4s for animation + 1.1s static highlight)
						setTimeout(() => {
							contactCard.classList.remove('highlighted');
						}, 3500);
					});
				});
			}

			// Intersection Observer for scroll animations
			const observerOptions = {
				root: null, // relative to the viewport
				rootMargin: '0px',
				threshold: 0.2 // Trigger when 20% of the element is visible (matches Framer Motion setting)
			};

			/**
			 * Intersection Observer Callback
			 * @param {IntersectionObserverEntry[]} entries
			 * @param {IntersectionObserver} observer
			 */
			const observerCallback = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
				entries.forEach((entry: IntersectionObserverEntry) => {
					if (entry.isIntersecting) {
						// Use type assertion for classList access
						(entry.target as HTMLElement).classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			};

			const observer = new IntersectionObserver(observerCallback, observerOptions);

			const targets = document.querySelectorAll('.animate-on-scroll');
			targets.forEach(target => {
				observer.observe(target);
			});

		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}

	/* Custom scrollbar for dark mode */
	::-webkit-scrollbar {
		width: 8px;
	}

	::-webkit-scrollbar-track {
		background: hsl(var(--color-background)); /* Use background color */
	}

	::-webkit-scrollbar-thumb {
		background: hsl(var(--color-border-secondary)); /* Use a slightly darker border color */
		border-radius: 4px;
	}

	::-webkit-scrollbar-thumb:hover {
		background: hsl(var(--color-brand-primary)); /* Use brand color on hover */
	}

	.nav-link::after {
	content: '';
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
	bottom: -6px;
	width: 100%;
	height: 15px;
	background-repeat: no-repeat;
	background-size: 100% 15px;
	background-position: bottom left;
	background-image: none;
	pointer-events: none;
	transition: background-image 0.2s;
}

.nav-link[aria-current='page']::after {
	background-image: url('data:image/svg+xml;utf8,<svg width="229" height="15" viewBox="0 0 229 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M220.877 12.1694C195.408 11.4984 169.953 10.5399 144.484 10.1976C107.451 9.70459 70.389 9.04732 33.4565 12.7035C25.9723 13.443 18.4881 14.1277 11.0183 14.8945C5.15737 15.4833 1.50867 13.6073 0.258908 9.25278C-0.789739 5.5966 1.43678 2.36489 5.31534 3.06326C18.7466 5.45963 31.862 1.9404 45.1352 1.62545C70.0298 1.02293 94.9244 0.269738 119.833 0.0369475C138.02 -0.127375 156.234 0.283445 174.42 0.735333C189.461 1.11875 204.486 1.94033 219.527 2.58393C220.403 2.62501 221.337 2.65245 222.127 2.9811C225.23 4.28199 229.941 5.0214 228.835 9.18424C228.304 11.1698 224.08 12.279 221.523 13.7716C221.308 13.2376 221.107 12.7035 220.891 12.1694H220.877Z" fill="%233670EC"/></svg>');
}

	.nav-link:hover::after,
	.nav-link[aria-current='page']::after { /* Style for active page link */
		width: 120%;
	}

	.footer-link::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 0;
		height: 1px; /* Thinner line for footer */
		background-color: hsl(var(--color-brand-primary)); /* Use theme color */
		transition: width 0.3s ease-out;
	}
	.footer-link:hover::after {
		width: 100%;
	}

	/* Contact card highlight effect */
	#contact-card {
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}

	@keyframes card-pulse {
		0% {
			border-color: hsl(var(--color-brand-primary));
			box-shadow: 0 0 0 2px hsl(var(--color-brand-primary) / 0.3), 0 0 15px 2px hsl(var(--color-brand-primary) / 0.2);
		}
		50% {
			border-color: hsl(var(--color-brand-primary));
			box-shadow: 0 0 0 3px hsl(var(--color-brand-primary) / 0.5), 0 0 25px 4px hsl(var(--color-brand-primary) / 0.4);
		}
		100% {
			border-color: hsl(var(--color-brand-primary));
			box-shadow: 0 0 0 2px hsl(var(--color-brand-primary) / 0.3), 0 0 15px 2px hsl(var(--color-brand-primary) / 0.2);
		}
	}

	#contact-card.highlighted {
		border-color: hsl(var(--color-brand-primary));
		box-shadow: 0 0 0 2px hsl(var(--color-brand-primary) / 0.3), 0 0 20px 2px hsl(var(--color-brand-primary) / 0.2);
		animation: card-pulse 0.8s ease-in-out 3;
	}
</style>
