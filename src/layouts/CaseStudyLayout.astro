---
import { Image } from 'astro:assets';
import Layout from './Layout.astro';
import Button from '../components/ui/Button.astro';

interface Props {
  title: string;
  description: string;
  coverImage: ImageMetadata;
  sections: Array<{
    id: string;
    title: string;
  }>;
  showTableOfContents?: boolean;
}

const { title, description, coverImage, sections, showTableOfContents = true } = Astro.props;
---

<Layout title={title} description={description}>
  <style is:global>
    html {
      scroll-behavior: smooth;
    }
    .toc-sidebar {
      position: sticky;
      top: 8rem;
      align-self: flex-start;
    }
    .gradient-overlay {
      background: linear-gradient(to bottom,
        hsl(var(--color-background) / 0.4) 0%,
        hsl(var(--color-background) / 0.6) 50%,
        hsl(var(--color-background) / 0.95) 100%
      );
    }
    .floating-back-button {
      position: fixed;
      bottom: 2rem;
      left: 2rem;
      z-index: 50;
      transition: transform 0.2s ease-in-out;
    }
    .floating-back-button:hover {
      transform: translateY(-2px);
    }
    @media (max-width: 640px) {
      .floating-back-button {
        bottom: 1.5rem;
        left: 1.5rem;
      }
    }
  </style>

  <div class="relative min-h-screen bg-background pb-24">
    <div class="w-full h-[40vh] md:h-[45vh] relative mb-24">
      <Image
        src={coverImage}
        alt={`Cover image for ${title}`}
        class="w-full h-full object-cover "
        style="object-position: 50% 60%;"
        widths={[400, 800, 1200, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        format="webp"
      />
      <div class="absolute inset-0 gradient-overlay"></div>
    </div>

    <div class="max-w-7xl xl:max-w-8xl mx-auto px-6 md:px-8 relative z-10 -mt-20 md:-mt-24">
      <div class="flex flex-col lg:flex-row gap-12 xl:gap-16">
        {showTableOfContents && sections && sections.length > 0 && (
          <aside class="w-full lg:w-64 flex-shrink-0 order-last lg:order-first">
            <div class="toc-sidebar p-6 bg-surface/80 backdrop-blur-sm rounded-xl shadow-card-light hidden lg:block">
              <h3 class="text-sm font-bold uppercase tracking-wider text-text-secondary mb-4">Quick Links</h3>
              <nav>
                <ul class="space-y-2">
                  {sections.map(section => (
                    <li>
                      <a
                        href={`#${section.id}`}
                        class="text-sm text-text-secondary hover:text-brand-primary transition-colors duration-200 block"
                      >
                        {section.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </aside>
        )}

        <main class="flex-1 min-w-0">
          <article class="bg-surface/80 backdrop-blur-sm rounded-xl shadow-card-light p-6 md:p-8 lg:p-10">
            <slot />
          </article>
        </main>
      </div>
    </div>

    <div class="floating-back-button">
      <Button
        href="/projects"
        variant="secondary"
        size="sm"
        class="bg-surface/95 backdrop-blur-sm shadow-lg hover:shadow-xl"
        icon="arrow-left"
      >
        Back to Projects
      </Button>
    </div>
  </div>
</Layout>