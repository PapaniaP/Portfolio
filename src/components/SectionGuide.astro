---
// Props definition
export interface Props {
  sections: {
    id: string;
    title: string;
    isActive?: boolean;
  }[];
  position?: 'left' | 'right';
  showLabels?: boolean;
}

const {
  sections,
  position = 'left',
  showLabels = true
} = Astro.props;

// Position styles
const positionClasses = position === 'left'
  ? 'left-6 items-start'
  : 'right-6 items-end';

// Connection line between dots
const lineConnectorClasses = position === 'left'
  ? 'left-2.5 ml-px'
  : 'right-2.5 mr-px';

// Label position
const labelClasses = position === 'left'
  ? 'left-8'
  : 'right-8';
---

<div class={`fixed ${positionClasses} top-1/2 transform -translate-y-1/2 z-50 hidden lg:flex flex-col`}>
  <div class="relative flex flex-col items-center space-y-8">
    <!-- Vertical connector line -->
    <div class={`absolute ${lineConnectorClasses} top-5 bottom-5 w-px bg-gray-700/30`}></div>

    {sections.map((section) => (
      <a href={`#${section.id}`} class="group relative z-10">
        <div class={`w-5 h-5 bg-gray-900 border ${section.isActive ? 'border-primary/50' : 'border-gray-700/50'} rounded-full flex items-center justify-center transition-colors duration-300 group-hover:border-primary/50`}>
          <div class={`${section.isActive ? 'w-2.5 h-2.5 bg-primary' : 'w-1.5 h-1.5 bg-gray-400'} rounded-full group-hover:bg-primary group-hover:w-2.5 group-hover:h-2.5 transition-all duration-300`}></div>
        </div>
        {showLabels && (
          <span class={`absolute ${labelClasses} top-0 ${position === 'left' ? 'opacity-0 group-hover:opacity-100' : ''} transition-opacity duration-300 bg-gray-800 text-white text-xs px-2 py-1 rounded whitespace-nowrap`}>
            {section.title}
          </span>
        )}
      </a>
    ))}
  </div>
</div>

<script>
  // Client-side script to update active section based on scroll position
  document.addEventListener('DOMContentLoaded', () => {
    // Get the current navigation context to avoid conflicts with multiple navigation components
    const navContainer = document.querySelector('.fixed.z-50.flex-col');
    if (!navContainer) return;

    const sectionElements = document.querySelectorAll('section[id]');
    const navigationDots = navContainer.querySelectorAll('a[href^="#"]');

    const setActiveSection = () => {
      let currentSectionId = '';
      let closestSection = null;
      let closestDistance = Infinity;

      // Find the section closest to the middle of the viewport
      const viewportMiddle = window.scrollY + window.innerHeight / 2;

      sectionElements.forEach((section) => {
        const sectionEl = section as HTMLElement;
        const sectionTop = sectionEl.offsetTop;
        const sectionBottom = sectionTop + sectionEl.offsetHeight;

        // Check if section is in view
        if (window.scrollY >= sectionTop - 200 &&
            window.scrollY < sectionBottom - 100) {

          // Calculate distance to viewport middle
          const distance = Math.abs(viewportMiddle - (sectionTop + sectionEl.offsetHeight / 2));

          // Update closest section if this one is closer to center
          if (distance < closestDistance) {
            closestDistance = distance;
            closestSection = section;
            currentSectionId = section.getAttribute('id') || '';
          }
        }
      });

      // If we're at the very top of the page, select the first section
      if (window.scrollY < 100 && sectionElements.length > 0) {
        currentSectionId = sectionElements[0].getAttribute('id') || '';
      }

      // If we're at the very bottom, select the last section
      if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 100) {
        currentSectionId = sectionElements[sectionElements.length - 1].getAttribute('id') || '';
      }

      // Update the navigation dots
      navigationDots.forEach((dot) => {
        const dotHref = dot.getAttribute('href');
        const dotSectionId = dotHref ? dotHref.substring(1) : '';

        // Find the inner dot element
        const innerDot = dot.querySelector('div > div');
        const outerDot = dot.querySelector('div');

        if (dotSectionId === currentSectionId) {
          // Active state
          innerDot?.classList.remove('w-1.5', 'h-1.5', 'bg-gray-400');
          innerDot?.classList.add('w-2.5', 'h-2.5', 'bg-primary');
          outerDot?.classList.remove('border-gray-700/50');
          outerDot?.classList.add('border-primary/50');
        } else {
          // Inactive state
          if (!dot.matches(':hover')) {
            innerDot?.classList.remove('w-2.5', 'h-2.5', 'bg-primary');
            innerDot?.classList.add('w-1.5', 'h-1.5', 'bg-gray-400');
            outerDot?.classList.remove('border-primary/50');
            outerDot?.classList.add('border-gray-700/50');
          }
        }
      });
    };

    // Call on scroll, resize, and initial load
    window.addEventListener('scroll', setActiveSection);
    window.addEventListener('resize', setActiveSection);
    setActiveSection();

    // Smooth scroll to section when clicking navigation dots
    navigationDots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        const href = dot.getAttribute('href');
        if (href) {
          const targetSection = document.querySelector(href);
          if (targetSection) {
            window.scrollTo({
              top: (targetSection as HTMLElement).offsetTop,
              behavior: 'smooth'
            });

            // Update active state immediately on click
            navigationDots.forEach((d) => {
              const innerDot = d.querySelector('div > div');
              const outerDot = d.querySelector('div');

              if (d === dot) {
                innerDot?.classList.remove('w-1.5', 'h-1.5', 'bg-gray-400');
                innerDot?.classList.add('w-2.5', 'h-2.5', 'bg-primary');
                outerDot?.classList.remove('border-gray-700/50');
                outerDot?.classList.add('border-primary/50');
              } else {
                innerDot?.classList.remove('w-2.5', 'h-2.5', 'bg-primary');
                innerDot?.classList.add('w-1.5', 'h-1.5', 'bg-gray-400');
                outerDot?.classList.remove('border-primary/50');
                outerDot?.classList.add('border-gray-700/50');
              }
            });
          }
        }
      });
    });
  });
</script>