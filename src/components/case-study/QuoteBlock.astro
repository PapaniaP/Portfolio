---
interface Props {
  quote: string;
  author?: string;
  role?: string;
  className?: string;
}

const { quote, author, role, className = "" } = Astro.props;
---

<blockquote class={`bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6 ${className}`}>
  <p class="text-gray-300 italic mb-4">"{quote}"</p>
  {(author || role) && (
    <footer class="text-gray-400">
      {author && `- ${author}`}
      {role && author && ", "}
      {role}
    </footer>
  )}
</blockquote>