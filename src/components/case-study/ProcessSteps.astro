---
// Props for the ProcessSteps component
interface ProcessStep {
  title: string;
  description: string;
  items: string[];
}

interface Props {
  steps: ProcessStep[];
}

const { steps } = Astro.props;
---

<div class="process-steps">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    {steps.map((step, index) => (
      <div class="bg-gray-800/20 backdrop-blur-sm rounded-lg p-8 relative">
        <div class="step-indicator">
          {[0, 1, 2, 3].map((lineIndex) => (
            <div class={`step-dot ${lineIndex === index ? 'active' : ''}`}></div>
          ))}
        </div>
        <div class="pl-4">
          <h3 class="text-xl font-medium text-white mb-3">{step.title}</h3>
          <p class="text-gray-400 mb-5 text-sm">{step.description}</p>

          <ul class="space-y-2">
            {step.items.map(item => (
              <li class="flex items-start">
                <span class="w-1 h-1 rounded-full bg-primary/40 mt-2 mr-2 flex-shrink-0"></span>
                <span class="text-gray-300 text-sm">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .process-steps {
    position: relative;
    padding: 1rem 0;
  }

  .step-indicator {
    position: absolute;
    top: 1.25rem;
    left: -0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
  }

  .step-dot {
    width: 3px;
    height: 12px;
    background-color: rgba(var(--color-gray-600-rgb, 75, 85, 99), 0.4);
    border-radius: 1px;
    transition: all 0.2s ease;
  }

  .step-dot.active {
    background-color: rgba(var(--color-primary-rgb, 79, 70, 229), 0.8);
    height: 24px;
  }

