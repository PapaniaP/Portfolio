---
interface Metric {
  value: string;
  label: string;
}

interface Props {
  metrics: Metric[];
  columns?: 2 | 3 | 4;
  className?: string;
}

const { metrics, columns = 2, className = "" } = Astro.props;

const gridCols = {
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-3",
  4: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4"
};
---

<div class={`grid ${gridCols[columns]} gap-8 ${className}`}>
  {metrics.map(metric => (
    <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6">
      <p class="text-4xl font-bold text-primary mb-2">{metric.value}</p>
      <p class="text-gray-300">{metric.label}</p>
    </div>
  ))}
</div>