---
import { Image } from 'astro:assets';

interface ImageItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: ImageItem[];
  columns?: 1 | 2 | 3 | 4;
  className?: string;
}

const { images, columns = 2, className = "" } = Astro.props;

const gridCols = {
  1: "grid-cols-1",
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4"
};
---

<div class={`grid ${gridCols[columns]} gap-6 ${className}`}>
  {images.map(image => (
    <figure class="rounded-xl overflow-hidden bg-gray-800/50 backdrop-blur-sm border border-gray-700/50">
      <Image
        src={image.src}
        alt={image.alt}
        class="w-full"
      />
      {image.caption && (
        <figcaption class="text-sm text-gray-400 p-4">
          {image.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>