---
import { Image } from 'astro:assets';

interface ImageItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: ImageItem[];
  columns?: 1 | 2 | 3 | 4;
  aspectRatio?: string;
  className?: string;
  hoverEffect?: boolean;
}

const {
  images,
  columns = 2,
  aspectRatio = "aspect-[4/3]",
  className = "",
  hoverEffect = true
} = Astro.props;

const gridCols = {
  1: "grid-cols-1",
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-3",
  4: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4"
};
---

<div class={`image-gallery grid ${gridCols[columns]} gap-6 ${className}`}>
  {images.map(image => (
    <figure class="rounded-xl overflow-hidden bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 flex flex-col h-full">
      <div class={`${aspectRatio} overflow-hidden w-full`}>
        <div class={`w-full h-full transition-transform duration-500 ${hoverEffect ? 'group' : ''}`}>
          <Image
            src={image.src}
            alt={image.alt}
            class={`w-full h-full object-cover ${hoverEffect ? 'group-hover:scale-105 transition-transform duration-500' : ''}`}
          />
        </div>
      </div>
      {image.caption && (
        <figcaption class="text-sm text-gray-400 p-4 flex-grow">
          {image.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>

<style>
  .image-gallery figure {
    display: flex;
    flex-direction: column;
  }

  .image-gallery figure > div {
    flex: 1 0 auto;
  }

  .image-gallery figcaption {
    flex: 0 0 auto;
  }
</style>