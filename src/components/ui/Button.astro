---
/*
  Button Component

  Usage:
  <Button href="/some-link" variant="primary">Click Me</Button>
  <Button variant="secondary" type="button" onClick="myFunction()">Click Me</Button>
  <Button icon="home" variant="primary">Home</Button>
  <Button icon="arrow-right" iconPosition="right" variant="secondary">Next</Button>

  Props:
  - variant: "primary" | "secondary" | "outline" | "ghost" | "terminal" (default: "primary")
  - size: "sm" | "md" | "lg" | "icon" (default: "md")
  - href: string (optional - if provided, renders as <a>, otherwise as <button>)
  - class: string (optional - additional classes)
  - icon: Icon name from the allowed list (optional)
  - iconPosition: "left" | "right" (default: "left")
  - disabled: boolean (optional - disables the button)
  - all other HTML attributes for button/anchor are passed through
*/

// Import only specific icons that we will use in buttons
import {
  Home,
  Settings,
  Download,
  Upload,
  Send,
  ChevronLeft,
  ChevronRight,
  ArrowLeft,
  ArrowRight,
  Plus,
  Minus,
  X,
  Check,
  Info,
  AlertCircle,
  Terminal,
  RefreshCw,
  Pencil,
  Trash2,
  Sun,
  Moon,
  Zap,
  LayoutGrid,
  Palette,
  Code,
  FileText,
  Menu
} from '@lucide/astro/icons';

// Map of allowed icon names to their components
const iconMap = {
  'home': Home,
  'settings': Settings,
  'download': Download,
  'upload': Upload,
  'send': Send,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
  'arrow-left': ArrowLeft,
  'arrow-right': ArrowRight,
  'plus': Plus,
  'minus': Minus,
  'x': X,
  'check': Check,
  'info': Info,
  'alert-circle': AlertCircle,
  'terminal': Terminal,
  'refresh-cw': RefreshCw,
  'pencil': Pencil,
  'trash-2': Trash2,
  'sun': Sun,
  'moon': Moon,
  'zap': Zap,
  'layout-grid': LayoutGrid,
  'palette': Palette,
  'code': Code,
  'file-text': FileText,
  'menu': Menu
};

// Type for allowed icon names
type IconName = keyof typeof iconMap;

export interface Props {
  variant?: "primary" | "secondary" | "outline" | "ghost" | "terminal";
  size?: "sm" | "md" | "lg" | "icon";
  href?: string;
  class?: string;
  icon?: IconName;
  iconPosition?: "left" | "right";
  disabled?: boolean;
  [x: string]: any;
}

const {
  variant = "primary",
  size = "md",
  href,
  class: className = "",
  icon,
  iconPosition = "left",
  disabled = false,
  ...rest
} = Astro.props;

// Base classes for all buttons
const baseClasses = "inline-flex items-center justify-center font-medium transition-all duration-200 select-none rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-primary/50 focus-visible:ring-offset-background disabled:opacity-50 disabled:pointer-events-none hover:shadow-md";

// Size variations
const sizeClasses = {
  sm: "h-9 px-3 text-sm",
  md: "h-10 py-2 px-4",
  lg: "h-11 px-6 text-base",
  icon: "h-10 w-10"
};

// Variant styles
const variantClasses = {
  primary: "bg-brand-primary text-text-inverted hover:bg-brand-primary-dark active:bg-brand-primary/90 shadow-sm",
  secondary: "bg-surface border border-border-secondary text-text-primary hover:bg-surface-accent active:bg-surface-transparent shadow-sm",
  outline: "border border-brand-primary text-brand-primary hover:bg-brand-primary/10 active:scale-[0.98]",
  ghost: "text-text-secondary hover:text-text-primary hover:bg-surface-accent",
};

// Size for icons
const iconSize = {
  sm: 16,
  md: 18,
  lg: 20,
  icon: 22
};

// Icon spacing
const iconSpacing = {
  sm: "mr-1.5",
  md: "mr-2",
  lg: "mr-2.5",
  icon: ""
};

const iconSpacingRight = {
  sm: "ml-1.5",
  md: "ml-2",
  lg: "ml-2.5",
  icon: ""
};

// Combined classes
const classes = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant as keyof typeof variantClasses]} ${className} ${disabled ? "opacity-50 cursor-not-allowed pointer-events-none" : ""}`;

const Element = href ? "a" : "button";

// Get the icon component, if the icon name is in our allowed list
const IconComponent = icon ? iconMap[icon] : null;
---

<Element
  href={disabled ? undefined : href}
  class={classes}
  {...rest}
  {...disabled && !href ? { disabled } : {}}
>
  {IconComponent && iconPosition === "left" && (
    <IconComponent
      size={iconSize[size]}
      class={size !== "icon" ? iconSpacing[size] : ""}
      color={variant === "primary" ? "#FFFFFF" : "currentColor"}
      stroke-width={2}
    />
  )}
  <slot />
  {IconComponent && iconPosition === "right" && (
    <IconComponent
      size={iconSize[size]}
      class={size !== "icon" ? iconSpacingRight[size] : ""}
      color={variant === "primary" ? "#FFFFFF" : "currentColor"}
      stroke-width={2}
    />
  )}
</Element>

<style>
  /* Custom active state with slight scale reduction */
  button:active, a:active {
    transform: scale(0.98);
  }

  /* Custom focus visible state using semantic color */
  button:focus-visible, a:focus-visible {
    outline: 2px solid theme('colors.brand-primary');
    outline-offset: 2px;
  }
</style>