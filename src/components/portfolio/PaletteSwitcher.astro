---
const palettes = [
  { id: 'teal', label: 'Teal + orange', colours: ['#27d6c5', '#ff791f'] },
  { id: 'blue', label: 'Blue + orange', colours: ['#0048ff', '#ff791f'] },
  { id: 'violet', label: 'Violet + gold', colours: ['#bfa1ff', '#ffd24a'] },
];
---
<div class="palette-switcher" role="group" aria-label="Compare colour combinations">
  {palettes.map(palette => (
    <button type="button" data-palette-choice={palette.id} aria-pressed={palette.id === 'teal' ? 'true' : 'false'}>
      <span class="palette-dots" aria-hidden="true">{palette.colours.map(colour => <i style={`background:${colour}`}></i>)}</span>
      {palette.label}
      <span class="palette-check" aria-hidden="true">✓</span>
    </button>
  ))}
</div>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-palette-choice]');
  const sync = () => {
    const palette = document.documentElement.dataset.palette;
    buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.paletteChoice === palette)));
    // Keep comparisons intact when moving between the portfolio and CV,
    // including when local storage is unavailable.
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(link => {
      const url = new URL(link.href);
      if (url.origin === location.origin && ['/', '/cv/'].includes(url.pathname) && !url.hash) {
        url.searchParams.set('palette', palette || 'teal');
        link.href = url.pathname + url.search;
      }
    });
  };
  buttons.forEach(button => button.addEventListener('click', () => {
    const palette = button.dataset.paletteChoice!;
    document.documentElement.dataset.palette = palette;
    try { localStorage.setItem('portfolio-palette', palette); } catch {}
    const url = new URL(location.href);
    url.searchParams.set('palette', palette);
    history.replaceState(null, '', url);
    sync();
  }));
  window.addEventListener('pageshow', sync);
  sync();
</script>
<style>
  .palette-switcher{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px;padding-bottom:22px;border-bottom:1px solid var(--line)}
  .palette-switcher button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;padding:8px 10px;border:1px solid var(--line);border-radius:5px;background:transparent;color:var(--muted);font-size:12px;line-height:1.3;letter-spacing:inherit}
  .palette-switcher button:hover{color:var(--ink);background:var(--soft)}
  .palette-switcher button[aria-pressed=true]{color:var(--blue);border-color:var(--blue);background:var(--soft)}
  .palette-dots{display:inline-flex;align-items:center;padding-right:2px}
  .palette-dots i{display:block;width:10px;height:10px;border-radius:50%;box-shadow:0 0 0 1px var(--paper)}
  .palette-dots i+i{margin-left:-2px}
  .palette-check{visibility:hidden;font-size:11px}
  [aria-pressed=true] .palette-check{visibility:visible}
  @media(max-width:420px){.palette-switcher{gap:6px}.palette-switcher button{justify-content:flex-start;flex:1 1 100%;padding:9px 12px}.palette-check{margin-left:auto}}
  @media print{.palette-switcher{display:none!important}}
</style>
