---
import 'drawably/style.css';
import '../../styles/drawn-accents.css';
---
<script>
  import { drawablyButton, drawablyUnderline, drawablyHighlight } from 'drawably';

  async function addSketches() {
    await document.fonts.ready;
    const options = { roughness: 0.7, boil: 0, width: 1.5 };
    document.querySelectorAll<HTMLElement>('[data-drawn-underline]').forEach(el => {
      drawablyUnderline(el, options);
    });
    document.querySelectorAll<HTMLElement>('[data-drawn-highlight]').forEach(el => {
      drawablyHighlight(el, options);
    });
    const buttons = [...document.querySelectorAll<HTMLElement>('[data-drawn-cta]')];
    let sketches: ReturnType<typeof drawablyButton>[] = [];
    const redrawButtons = () => {
      sketches.forEach(sketch => sketch.destroy());
      const variant = document.documentElement.dataset.theme === 'light' ? 'solid' : 'outline';
      sketches = buttons.map(el => {
        el.classList.remove('drawably-button--solid', 'drawably-button--outline');
        return drawablyButton(el, { ...options, variant });
      });
    };
    redrawButtons();
    new MutationObserver(redrawButtons).observe(document.documentElement, {
      attributes: true, attributeFilter: ['data-theme'],
    });
  }
  addSketches();
</script>
